<Page
    x:Class="TeXLocal.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bridge="using:TeXLocal.Bridge"
    xmlns:local="using:TeXLocal.Pages"
    Background="Transparent">

    <Grid Style="{StaticResource ContentCardStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel MaxWidth="1064" Padding="36,0,36,0">
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextBlockStyle}" Text="Projects" />

            <Grid Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="NewButton"
                        AutomationProperties.Name="New project"
                        Click="OnNew"
                        Style="{StaticResource AccentButtonStyle}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N" Modifiers="Control,Shift" />
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                            <TextBlock Text="New project" />
                        </StackPanel>
                    </Button>
                    <DropDownButton Content="Open">
                        <DropDownButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control" />
                        </DropDownButton.KeyboardAccelerators>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Click="OnOpenFolder" Text="Folder…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="OnOpenFile" Text="ZIP or TeX file…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Settings"
                    Click="OnSettings"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Settings (Ctrl+,)">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </Grid>

            <!-- Collapsed while closed, so a closed bar leaves no gap. -->
            <InfoBar
                x:Name="LibraryError"
                Title="Can't open the projects folder"
                Margin="0,12,0,0"
                IsClosable="False"
                Severity="Error"
                Visibility="{x:Bind LibraryError.IsOpen, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Click="OnRetry" Content="Try again" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Name="TexMissing"
                Title="TeX isn't installed"
                Margin="0,12,0,0"
                IsClosable="False"
                Message="TeXLocal compiles with TeX Live."
                Severity="Warning"
                Visibility="{x:Bind TexMissing.IsOpen, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="Get TeX Live" NavigateUri="https://tug.org/texlive/windows.html" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Full width so the scroll bar sits at the page's edge; the cards keep to the header's column (1064 less the padding). -->
        <ListView
            x:Name="List"
            Grid.Row="1"
            Padding="36,12,36,32"
            AutomationProperties.Name="Projects"
            ContainerContentChanging="OnContainerContentChanging"
            ContextRequested="OnContextRequested"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemContainerStyle="{StaticResource CardListViewItemStyle}"
            SelectionMode="None">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel MaxWidth="992" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ContextFlyout>
                <MenuFlyout x:Name="ProjectMenu">
                    <MenuFlyoutItem Click="OnOpenItem" Text="Open">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8E5;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Click="OnRenameItem" Text="Rename">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8AC;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F2" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Click="OnRevealItem" Text="Show in File Explorer">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xEC50;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Click="OnExportItem" Text="Export as ZIP…">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7B8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnDeleteItem" Text="Delete">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Delete" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="bridge:ProjectInfo">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" FontSize="32" Glyph="&#xE8B7;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind Name}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind local:HomePage.Caption(MainFile, Mtime)}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind local:HomePage.MoreName(Name)}"
                            Click="OnMore"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="More options">
                            <FontIcon FontSize="16" Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="Empty"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="48"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE8B7;" />
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="No projects yet" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Create a project or open a folder, a ZIP or a .tex file."
                TextAlignment="Center" />
            <Button
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Click="OnNew"
                Content="New project"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <ContentDialog
            x:Name="NewDialog"
            Title="New project"
            CloseButtonText="Cancel"
            DefaultButton="Primary"
            IsPrimaryButtonEnabled="False"
            PrimaryButtonClick="OnCreate"
            PrimaryButtonText="Create"
            Style="{StaticResource DefaultContentDialogStyle}">
            <StackPanel Width="360" Spacing="8">
                <TextBox x:Name="NameBox" Header="Name" TextChanged="OnNameChanged" />
                <TextBlock
                    x:Name="NameError"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="DeleteDialog"
            CloseButtonText="Cancel"
            Content="The project folder moves to the Recycle Bin."
            DefaultButton="Close"
            PrimaryButtonText="Move to Recycle Bin"
            Style="{StaticResource DefaultContentDialogStyle}" />
    </Grid>
</Page>
