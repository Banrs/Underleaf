<Page
    x:Class="TeXLocal.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bridge="using:TeXLocal.Bridge"
    xmlns:controls="using:TeXLocal.Controls"
    xmlns:local="using:TeXLocal.Pages"
    Background="Transparent">
    <Page.Resources>
        <x:Double x:Key="PageMaxWidth">1064</x:Double>
        <x:Double x:Key="PageColumnWidth">992</x:Double>

        <!-- One menu for a row's right-click or context key and for its More button; F2 and Del are the list's. -->
        <MenuFlyout x:Key="ProjectMenu" Opening="OnMenuOpening" Placement="BottomEdgeAlignedRight">
            <MenuFlyoutItem Click="OnOpenItem" Text="Open">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnRenameItem" KeyboardAcceleratorTextOverride="F2" Text="Rename">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnRevealItem" Text="Show in File Explorer">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC50;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnExportItem" Text="Export as ZIP…">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="OnDeleteItem" KeyboardAcceleratorTextOverride="Del" Text="Delete">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!-- Installed apps' rows on the stock item, whose fill, hover and press sit 4,2 inside its bounds: the item reaches
             4 past the column, and its padding lays the card's stroke on that fill. Rows are 2 + 2 apart. -->
        <Style x:Key="ProjectItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Margin" Value="-4,0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FocusVisualMargin" Value="2,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ContextFlyout" Value="{StaticResource ProjectMenu}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="36,0">
            <TextBlock Margin="0,24,0,0" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource TitleTextBlockStyle}" Text="Projects" />
            <StackPanel Margin="0,16,0,0" Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="NewButton"
                    controls:Shortcut.Keys="Ctrl+Shift+N"
                    AutomationProperties.Name="New project"
                    Click="OnNew"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                        <TextBlock Text="New project" />
                    </StackPanel>
                </Button>
                <DropDownButton Content="Open">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+O" Click="OnOpenFolder" Text="Folder…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+Shift+O" Click="OnOpenFile" Text="ZIP or TeX file…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <!-- Collapsed while closed, so a closed bar leaves no gap. -->
            <InfoBar
                x:Name="LibraryError"
                Title="Can't open the projects folder"
                Margin="0,12,0,0"
                IsClosable="False"
                Severity="Error"
                Visibility="{x:Bind LibraryError.IsOpen, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Click="OnRetry" Content="Try again" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Name="TexMissing"
                Title="TeX isn't installed"
                Margin="0,12,0,0"
                IsClosable="False"
                Message="TeXLocal compiles with TeX Live."
                Severity="Warning"
                Visibility="{x:Bind TexMissing.IsOpen, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="Get TeX Live" NavigateUri="https://tug.org/texlive/windows.html" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Full width so the scroll bar sits at the page's edge; the rows keep to the header's column. -->
        <ListView
            x:Name="List"
            Grid.Row="1"
            Padding="36,12,36,36"
            AutomationProperties.Name="Projects"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemContainerStyle="{StaticResource ProjectItemStyle}"
            KeyboardAcceleratorPlacementMode="Hidden"
            SelectionMode="None">
            <ListView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
                            <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="ControlFillColorTertiaryBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
                            <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="ControlFillColorTertiaryBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast" />
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ListView.Resources>
            <ListView.KeyboardAccelerators>
                <KeyboardAccelerator Key="F2" Invoked="OnKey" ScopeOwner="{x:Bind List}" />
                <KeyboardAccelerator Key="Delete" Invoked="OnKey" ScopeOwner="{x:Bind List}" />
            </ListView.KeyboardAccelerators>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel MaxWidth="{StaticResource PageColumnWidth}" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="bridge:ProjectInfo">
                    <Border Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="32" Glyph="&#xE8B7;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="NameText"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind Name}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind local:HomePage.Caption(MainFile, Mtime)}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind local:HomePage.MoreName(Name)}"
                                Flyout="{StaticResource ProjectMenu}"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="More options">
                                <FontIcon FontSize="16" Glyph="&#xE712;" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="Empty"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon HorizontalAlignment="Center" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE8B7;" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="No projects yet" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyTextBlockStyle}" Text="Create a project, or open a folder or a .zip." />
            <Button HorizontalAlignment="Center" Click="OnNew" Content="New project" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
