<Page
    x:Class="TeXLocal.Pages.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:TeXLocal"
    xmlns:controls="using:TeXLocal.Controls"
    xmlns:local="using:TeXLocal.Pages"
    Background="Transparent"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <!-- Margins rather than column spacing, so a row without a glyph starts where the glyph would. -->
        <DataTemplate x:Key="NavTemplate" x:DataType="local:NavItem">
            <TreeViewItem AutomationProperties.Name="{x:Bind Spoken}" IsExpanded="{x:Bind IsExpanded}" ItemsSource="{x:Bind Children}" ToolTipService.ToolTip="{x:Bind Tip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Margin="0,0,12,0" FontSize="16" Glyph="{x:Bind Glyph}" Visibility="{x:Bind HasGlyph}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" MaxLines="{x:Bind Lines}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind Lead}" /><Run FontWeight="SemiBold" Text="{x:Bind Strong}" /><Run Text="{x:Bind Tail}" />
                    </TextBlock>
                    <TextBlock
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Trailing}"
                        Typography.NumeralAlignment="Tabular" />
                    <FontIcon Grid.Column="2" Margin="12,0,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE735;" Visibility="{x:Bind IsMain}" />
                </Grid>
            </TreeViewItem>
        </DataTemplate>
        <Style TargetType="TreeView">
            <Setter Property="CanDragItems" Value="False" />
            <Setter Property="CanReorderItems" Value="False" />
            <Setter Property="ItemTemplate" Value="{StaticResource NavTemplate}" />
        </Style>
        <!-- Word's Equation (π) and Symbol (Ω) buttons draw their letters in the maths font. -->
        <Style x:Key="MathsIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="Cambria Math" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <!-- The status bar's zoom, as Word's: a slider between out and in, 100% at its middle. -->
        <Style x:Key="ZoomStepStyle" TargetType="RepeatButton" BasedOn="{StaticResource DefaultRepeatButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Invoked="OnNextRegion" Key="F6" />
        <KeyboardAccelerator Invoked="OnNextRegion" Key="F6" Modifiers="Shift" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Narrow, the navigation pane overlays the layers on acrylic; wide (1008 and up, the Fluent breakpoint), it sits
             beside them on Mica, and the status bar has room for the zoom slider. The page's width sets the trigger:
             an AdaptiveTrigger misjudges a page first shown in a narrow window. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <StateTrigger x:Name="WideTrigger" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Split.DisplayMode" Value="Inline" />
                        <Setter Target="Split.PaneBackground" Value="Transparent" />
                        <Setter Target="ZoomSlider.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- The title bar holds these while the project is open (MainWindow.SetMenu), as Paint's and Visual Studio's do. -->
        <Border x:Name="MenuSlot" Visibility="Collapsed">
            <MenuBar x:Name="MainMenu">
                <MenuBarItem AccessKey="F" Title="File">
                    <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+N" AccessKey="N" Click="OnNewFile" Text="New file" />
                    <MenuFlyoutItem AccessKey="F" Click="OnNewFolder" Text="New folder" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem AccessKey="O" Text="Open">
                        <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+O" AccessKey="F" Click="{x:Bind app:App.Window.OpenFolder}" Text="Folder…" />
                        <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+Shift+O" AccessKey="Z" Click="{x:Bind app:App.Window.OpenFile}" Text="ZIP or TeX file…" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+S" AccessKey="S" Click="OnSave" Text="Save" />
                    <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+W" AccessKey="C" Click="{x:Bind app:App.Window.GoHome}" Text="Close project" />
                    <MenuFlyoutSeparator />
                    <!-- The window handles Ctrl+, itself: the editor swallows it before accelerators. -->
                    <MenuFlyoutItem AccessKey="T" Click="{x:Bind app:App.Window.OpenSettings}" KeyboardAcceleratorTextOverride="Ctrl+," Text="Settings" />
                </MenuBarItem>
                <!-- The editor owns undo, the clipboard and moving lines, so their keys are only shown. -->
                <MenuBarItem AccessKey="E" Title="Edit">
                    <MenuFlyoutItem AccessKey="U" Click="{x:Bind Editor.Undo}" KeyboardAcceleratorTextOverride="Ctrl+Z" Text="Undo" />
                    <MenuFlyoutItem AccessKey="R" Click="{x:Bind Editor.Redo}" KeyboardAcceleratorTextOverride="Ctrl+Y" Text="Redo" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem AccessKey="T" Click="{x:Bind Editor.Cut}" KeyboardAcceleratorTextOverride="Ctrl+X" Text="Cut" />
                    <MenuFlyoutItem AccessKey="C" Click="{x:Bind Editor.Copy}" KeyboardAcceleratorTextOverride="Ctrl+C" Text="Copy" />
                    <MenuFlyoutItem AccessKey="P" Click="{x:Bind Editor.Paste}" KeyboardAcceleratorTextOverride="Ctrl+V" Text="Paste" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+F" AccessKey="F" Click="OnFind" Text="Find…" />
                    <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+H" AccessKey="E" Click="OnReplace" Text="Replace…" />
                    <MenuFlyoutItem controls:Shortcut.Keys="F3" AccessKey="N" Click="OnFindNext" Text="Find next" />
                    <MenuFlyoutItem controls:Shortcut.Keys="Shift+F3" AccessKey="V" Click="OnFindPrevious" Text="Find previous" />
                    <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+Shift+F" AccessKey="J" Click="OnFindInProject" Text="Find in project…" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+/" AccessKey="M" Click="{x:Bind Editor.ToggleComment}" Text="Toggle comment" />
                    <MenuFlyoutItem AccessKey="O" Click="OnMoveLineUp" KeyboardAcceleratorTextOverride="Alt+Up" Text="Move line up" />
                    <MenuFlyoutItem AccessKey="W" Click="OnMoveLineDown" KeyboardAcceleratorTextOverride="Alt+Down" Text="Move line down" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+G" AccessKey="G" Click="OnGoToLine" Text="Go to line…" />
                    <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+Alt+G" AccessKey="A" Click="OnGoToPage" Text="Go to page…" />
                    <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+Alt+J" AccessKey="D" Click="OnForwardSync" Text="Go to PDF position" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem controls:Shortcut.Keys="F8" AccessKey="I" Click="OnNextIssue" Text="Next issue" />
                    <MenuFlyoutItem controls:Shortcut.Keys="Shift+F8" AccessKey="S" Click="OnPreviousIssue" Text="Previous issue" />
                </MenuBarItem>
                <!-- The catalogue's templates follow MathsAnchor and InsertAnchor, and fill List and References. The keys
                     here are the editor's (Shortcut.Scope, set in code: the XAML compiler fails on x:Bind to it). -->
                <MenuBarItem x:Name="InsertMenu" AccessKey="I" Title="Insert">
                    <MenuFlyoutSubItem x:Name="HeadingMenu" AccessKey="H" Text="Heading" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="BoldItem" controls:Shortcut.Keys="Ctrl+B" AccessKey="B" Click="OnStyle" Tag="bold" Text="Bold">
                        <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DD;" /></ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="ItalicItem" controls:Shortcut.Keys="Ctrl+I" AccessKey="I" Click="OnStyle" Tag="italic" Text="Italic">
                        <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DB;" /></ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="UnderlineItem" controls:Shortcut.Keys="Ctrl+U" AccessKey="U" Click="OnStyle" Tag="underline" Text="Underline">
                        <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DC;" /></ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="InlineItem" controls:Shortcut.Keys="Alt+=" AccessKey="M" Click="OnInlineMaths" Text="Inline maths" />
                    <MenuFlyoutItem x:Name="MathsAnchor" AccessKey="D" Click="OnDisplayMaths" Text="Display maths" />
                    <MenuFlyoutItem x:Name="SymbolItem" controls:Shortcut.Keys="Alt+Shift+=" AccessKey="Y" Click="OnSymbols" Text="Symbol…" />
                    <MenuFlyoutSeparator x:Name="InsertAnchor" />
                    <MenuFlyoutSubItem x:Name="ListMenu" AccessKey="L" Text="List" />
                    <MenuFlyoutSubItem x:Name="ReferencesMenu" AccessKey="R" Text="References and links" />
                </MenuBarItem>
                <MenuBarItem AccessKey="V" Title="View">
                    <ToggleMenuFlyoutItem controls:Shortcut.Keys="Ctrl+Shift+E" AccessKey="N" IsChecked="{x:Bind Split.IsPaneOpen, Mode=TwoWay}" Text="Navigation pane" />
                    <MenuFlyoutItem AccessKey="O" Click="OnShowOutline" Text="Outline" />
                    <ToggleMenuFlyoutItem x:Name="PdfItem" controls:Shortcut.Keys="Ctrl+Alt+P" AccessKey="P" Click="OnPdfPane" IsChecked="True" Text="PDF" />
                    <ToggleMenuFlyoutItem x:Name="IssuesItem" controls:Shortcut.Keys="Ctrl+Shift+M" AccessKey="I" Click="OnIssuesPane" Text="Issues" />
                    <MenuFlyoutSeparator />
                    <!-- The PDF's, wherever the focus is: the editor has no zoom of its own. -->
                    <MenuFlyoutSubItem AccessKey="Z" Text="Zoom">
                        <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+=; Ctrl+Add" AccessKey="I" Click="{x:Bind Pdf.ZoomIn}" Text="Zoom in" />
                        <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+-; Ctrl+Subtract" AccessKey="O" Click="{x:Bind Pdf.ZoomOut}" Text="Zoom out" />
                        <MenuFlyoutItem controls:Shortcut.Keys="Ctrl+0" AccessKey="A" Click="OnActualSize" Text="Actual size" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem AccessKey="W" Click="{x:Bind Pdf.FitWidth}" Text="Fit width" />
                        <MenuFlyoutItem AccessKey="P" Click="{x:Bind Pdf.FitPage}" Text="Fit page" />
                    </MenuFlyoutSubItem>
                </MenuBarItem>
                <MenuBarItem AccessKey="B" Title="Build">
                    <MenuFlyoutItem x:Name="CompileItem" controls:Shortcut.Keys="Ctrl+Enter; F5" AccessKey="C" Click="OnCompile" Text="Compile" />
                    <MenuFlyoutItem x:Name="StopItem" controls:Shortcut.Keys="Shift+F5" AccessKey="S" Click="OnStop" IsEnabled="False" Text="Stop" />
                    <MenuFlyoutItem AccessKey="L" Click="OnClean" Text="Clean build folder" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="AutoCompileItem" AccessKey="A" Click="OnAutoCompile" IsChecked="{x:Bind app:Prefs.AutoCompile, Mode=OneTime}" Text="Compile automatically" />
                    <ToggleMenuFlyoutItem x:Name="ShellEscapeItem" AccessKey="E" Click="OnBuildSetting" Text="Shell escape" />
                    <ToggleMenuFlyoutItem x:Name="StopOnErrorItem" AccessKey="F" Click="OnBuildSetting" Text="Stop on first error" />
                </MenuBarItem>
            </MenuBar>
        </Border>

        <!-- The command bar, as File Explorer's and Notepad's formatting bar: the pane, the text's style, Word's Equation,
             Symbol and Insert; the PDF and Compile at its end, as Visual Studio's Start. Commands without room go to its
             overflow. -->
        <Grid Padding="4,0,8,0">
            <!-- Word's ribbon toggles: a checked one sits on a subtle fill, so Compile stays the one accent. -->
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <StaticResource x:Key="AppBarToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                            <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <StaticResource x:Key="AppBarToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                            <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                            <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                            <StaticResource x:Key="AppBarToggleButtonBorderBrushChecked" ResourceKey="ControlFillColorTransparentBrush" />
                            <StaticResource x:Key="AppBarToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="AppBarToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                            <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <StaticResource x:Key="AppBarToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                            <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                            <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                            <StaticResource x:Key="AppBarToggleButtonBorderBrushChecked" ResourceKey="ControlFillColorTransparentBrush" />
                            <StaticResource x:Key="AppBarToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast" />
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CommandBar
                x:Name="Tools"
                HorizontalAlignment="Left"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <AppBarToggleButton
                    x:Name="PaneButton"
                    Width="40"
                    IsChecked="{x:Bind Split.IsPaneOpen, Mode=TwoWay}"
                    Label="Navigation pane"
                    LabelPosition="Collapsed"
                    ToolTipService.ToolTip="Navigation pane (Ctrl+Shift+E)">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE700;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarSeparator />
                <AppBarElementContainer VerticalAlignment="Center" AutomationProperties.Name="Text style">
                    <DropDownButton
                        x:Name="StyleButton"
                        Width="168"
                        Margin="4,0"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Text style"
                        ToolTipService.ToolTip="Text style">
                        <TextBlock x:Name="StyleText" Text="Normal text" TextTrimming="CharacterEllipsis" />
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="StyleMenu" Placement="BottomEdgeAlignedLeft" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </AppBarElementContainer>
                <AppBarToggleButton x:Name="BoldButton"
                    Width="40" Click="OnStyle" Label="Bold" LabelPosition="Collapsed" Tag="bold" ToolTipService.ToolTip="Bold (Ctrl+B)">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8DD;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="ItalicButton"
                    Width="40" Click="OnStyle" Label="Italic" LabelPosition="Collapsed" Tag="italic" ToolTipService.ToolTip="Italic (Ctrl+I)">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8DB;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="UnderlineButton"
                    Width="40" Click="OnStyle" Label="Underline" LabelPosition="Collapsed" Tag="underline" ToolTipService.ToolTip="Underline (Ctrl+U)">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8DC;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarSeparator />
                <AppBarButton x:Name="EquationButton" Label="Equation" ToolTipService.ToolTip="Equation">
                    <AppBarButton.Icon><FontIcon Glyph="π" Style="{StaticResource MathsIconStyle}" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="EquationMenu" Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Click="OnInlineMaths" KeyboardAcceleratorTextOverride="Alt+=" Text="Inline maths" />
                            <MenuFlyoutItem x:Name="EquationAnchor" Click="OnDisplayMaths" Text="Display maths" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="SymbolButton" Click="OnSymbols" Label="Symbol" ToolTipService.ToolTip="Symbol (Alt+Shift+=)">
                    <AppBarButton.Icon><FontIcon Glyph="Ω" Style="{StaticResource MathsIconStyle}" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="InsertButton" Label="Insert" ToolTipService.ToolTip="Insert">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="InsertFlyout" Placement="BottomEdgeAlignedLeft" />
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
            <CommandBar
                Grid.Column="1"
                Background="Transparent"
                DefaultLabelPosition="Right"
                OverflowButtonVisibility="Collapsed">
                <AppBarToggleButton
                    x:Name="PdfButton"
                    Width="40"
                    Click="OnPdfButton"
                    IsChecked="True"
                    Label="PDF"
                    LabelPosition="Collapsed"
                    ToolTipService.ToolTip="PDF (Ctrl+Alt+P)">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xEA90;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarSeparator />
                <AppBarElementContainer VerticalAlignment="Center">
                    <Button
                        x:Name="CompileButton"
                        Width="112"
                        Margin="4,0,0,0"
                        AutomationProperties.Name="Compile"
                        Click="OnCompileButton"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Compile (Ctrl+Enter)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="CompileIcon" FontSize="16" Glyph="&#xE768;" />
                            <TextBlock x:Name="CompileLabel" Text="Compile" />
                        </StackPanel>
                    </Button>
                </AppBarElementContainer>
            </CommandBar>
        </Grid>

        <SplitView
            x:Name="Split"
            Grid.Row="1"
            OpenPaneLength="{x:Bind app:Prefs.SidebarWidth, Mode=OneTime}"
            PaneBackground="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <!-- Word's navigation pane: its search box over Files, the Outline of the shown file's document, and Results. -->
            <SplitView.Pane>
                <Grid x:Name="SidePane" Padding="8,4,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="Search"
                        Margin="4,0,4,4"
                        AutomationProperties.Name="Search in project"
                        KeyDown="OnSearchKey"
                        QuerySubmitted="OnSearchSubmitted"
                        TextChanged="OnSearchChanged">
                        <AutoSuggestBox.QueryIcon>
                            <FontIcon FontSize="12" Glyph="&#xE721;" />
                        </AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>
                    <SelectorBar x:Name="SideTabs" Grid.Row="1" Margin="0,0,0,4" SelectionChanged="OnSideTab">
                        <SelectorBarItem x:Name="FilesTab" IsSelected="True" Text="Files" />
                        <SelectorBarItem x:Name="OutlineTab" Text="Outline" />
                        <SelectorBarItem x:Name="ResultsTab" Text="Results" />
                    </SelectorBar>
                    <TreeView
                        x:Name="FilesTree"
                        Grid.Row="2"
                        AllowDrop="True"
                        AutomationProperties.Name="Files"
                        Collapsed="OnCollapsed"
                        ContextRequested="OnFilesContext"
                        DragOver="OnDragOver"
                        Drop="OnDrop"
                        Expanding="OnExpanding"
                        ItemInvoked="OnInvoked"
                        SelectionChanged="{x:Bind ShowFileCommands}">
                        <!-- File Explorer's menu, with its icons. -->
                        <TreeView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OnNewFile" Text="New file">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="OnNewFolder" Text="New folder">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MainItem" Click="OnSetMain" Text="Set as main file">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE735;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="RenameItem" controls:Shortcut.Keys="F2" Click="OnRename" Text="Rename">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="RevealItem" Click="OnReveal" Text="Show in File Explorer">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC50;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="DeleteItem" controls:Shortcut.Keys="Delete" Click="OnDelete" Text="Delete">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </TreeView.ContextFlyout>
                    </TreeView>
                    <TreeView
                        x:Name="OutlineTree"
                        Grid.Row="2"
                        AutomationProperties.Name="Outline"
                        Collapsed="OnCollapsed"
                        Expanding="OnExpanding"
                        ItemInvoked="OnInvoked"
                        Visibility="Collapsed" />
                    <TreeView
                        x:Name="ResultsTree"
                        Grid.Row="2"
                        AutomationProperties.Name="Search results"
                        ItemInvoked="OnInvoked"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="SideNote"
                        Grid.Row="2"
                        Margin="12,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Visibility="Collapsed" />
                    <!-- The gap between the pane and the layers is its splitter. -->
                    <controls:Sizer x:Name="PaneSizer" Grid.RowSpan="3" Grid.Column="1" AutomationProperties.Name="Navigation pane width" />
                </Grid>
            </SplitView.Pane>

            <Grid x:Name="Body" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="IssuesRow" Height="0" />
                </Grid.RowDefinitions>

                <Grid x:Name="Panes">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="PdfColumn" Width="*" MinWidth="240" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="EditorLayer" Style="{StaticResource LayerStyle}">
                        <Grid x:Name="EditorClip">
                            <controls:SourceView x:Name="Editor" Visibility="Collapsed">
                                <!-- The emoji panel's way: a search box over the symbols by kind, never over the caret's line. Seven
                                     44 cells across (48 with their gap), in a size that holds while the search narrows them. -->
                                <FlyoutBase.AttachedFlyout>
                                    <Flyout x:Name="Palette">
                                        <StackPanel Spacing="8">
                                            <TextBox x:Name="SymbolFilter" AutomationProperties.Name="Search symbols" PlaceholderText="Search symbols" TextChanged="OnSymbolFilter" />
                                            <GridView
                                                x:Name="Symbols"
                                                Width="336"
                                                Height="360"
                                                AutomationProperties.Name="Symbols"
                                                IsItemClickEnabled="True"
                                                ItemClick="OnSymbol"
                                                SelectionMode="None">
                                                <GridView.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsWrapGrid MaximumRowsOrColumns="7" Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </GridView.ItemsPanel>
                                                <GridView.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate x:DataType="local:PaletteGroup">
                                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                                            </DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                    </GroupStyle>
                                                </GridView.GroupStyle>
                                                <GridView.ItemTemplate>
                                                    <DataTemplate x:DataType="local:PaletteItem">
                                                        <Image Width="24" Height="24" Source="{x:Bind Image}" ToolTipService.ToolTip="{x:Bind Command}" />
                                                    </DataTemplate>
                                                </GridView.ItemTemplate>
                                            </GridView>
                                        </StackPanel>
                                    </Flyout>
                                </FlyoutBase.AttachedFlyout>
                            </controls:SourceView>
                            <StackPanel x:Name="NoFile" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <FontIcon HorizontalAlignment="Center" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE8A5;" />
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="No file open" />
                                <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyTextBlockStyle}" Text="Choose a file in the navigation pane." />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <controls:Sizer x:Name="SplitSizer" Grid.Column="1" AutomationProperties.Name="Editor and PDF" DoubleTapped="OnSplitReset" />
                    <Border x:Name="PdfLayer" Grid.Column="2" Style="{StaticResource LayerStyle}">
                        <Grid x:Name="PdfClip">
                            <controls:PdfView x:Name="Pdf" />
                            <!-- Over the PDF, so it never covers the text or the find bar. -->
                            <InfoBar x:Name="BuildFailed" Margin="12" VerticalAlignment="Top" Severity="Error" Title="Build failed">
                                <InfoBar.ActionButton>
                                    <Button Click="OnShowIssues" Content="Show issues" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </Grid>
                    </Border>
                </Grid>

                <controls:Sizer x:Name="IssuesSizer" Grid.Row="1" AutomationProperties.Name="Issues height" Orientation="Horizontal" Visibility="Collapsed" />

                <!-- Visual Studio's Error List: the build's issues, or its log. -->
                <Border x:Name="IssuesPanel" Grid.Row="2" Style="{StaticResource LayerStyle}" Visibility="Collapsed">
                    <Grid x:Name="IssuesClip">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="4,0,4,0" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SelectorBar x:Name="IssueTabs" VerticalAlignment="Center" SelectionChanged="OnIssueTab">
                                <SelectorBarItem x:Name="IssuesTab" IsSelected="True" Text="Issues" />
                                <SelectorBarItem x:Name="LogTab" Text="Build log" />
                            </SelectorBar>
                            <!-- The Error List's filter: warnings shown or not, with their count. -->
                            <ToggleButton
                                x:Name="WarningsToggle"
                                Grid.Column="1"
                                AutomationProperties.Name="Warnings"
                                Checked="OnWarnings"
                                IsChecked="True"
                                IsEnabled="False"
                                Unchecked="OnWarnings">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" />
                                    <TextBlock x:Name="WarningsLabel" Text="0 warnings" Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </ToggleButton>
                            <Button x:Name="CopyLog" Grid.Column="1" Click="OnCopyLog" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                    <TextBlock Text="Copy log" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                AutomationProperties.Name="Close issues"
                                Click="OnCloseIssues"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Close (Ctrl+Shift+M)">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                        <ListView x:Name="IssueList" Grid.Row="1" Padding="0,0,0,4" AutomationProperties.Name="Issues" IsItemClickEnabled="True" ItemClick="OnIssueClick" Visibility="Collapsed">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:IssueItem">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon VerticalAlignment="Top" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xEB90;" Visibility="{x:Bind IsError}" />
                                        <FontIcon VerticalAlignment="Top" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" Visibility="{x:Bind IsWarning}" />
                                        <TextBlock Grid.Column="1" MaxLines="2" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Item.Message}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Place}"
                                            Typography.NumeralAlignment="Tabular"
                                            Visibility="{x:Bind HasPlace}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="NoIssues"
                            Grid.Row="1"
                            Margin="16,4"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Compile to check for issues." />
                        <TextBox
                            x:Name="Log"
                            Grid.Row="1"
                            Margin="8,0,8,8"
                            AcceptsReturn="True"
                            AutomationProperties.Name="Build log"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            IsReadOnly="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </SplitView>

        <!-- Word's and Notepad's status bar: the build at the left; the file's place, words, page and zoom at the right,
             in slots that keep their size, a line between groups. Narrow, the build's words trim and the slider goes, as
             Word's status bar gives way. -->
        <Grid Grid.Row="2" Padding="4,0,8,0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button AutomationProperties.Name="Issues" Click="OnIssueCounts" Style="{StaticResource StatusButtonStyle}" ToolTipService.ToolTip="Issues (Ctrl+Shift+M)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE783;" />
                    <TextBlock x:Name="ErrorCount" MinWidth="12" Style="{StaticResource CaptionTextBlockStyle}" Text="0" Typography.NumeralAlignment="Tabular" />
                    <FontIcon Margin="4,0,0,0" FontSize="12" Glyph="&#xE7BA;" />
                    <TextBlock x:Name="WarningCount" MinWidth="12" Style="{StaticResource CaptionTextBlockStyle}" Text="0" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Button>
            <TextBlock
                x:Name="BuildState"
                Grid.Column="1"
                Style="{StaticResource StatusTextStyle}"
                Text="No build yet"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind BuildState.Text, Mode=OneWay}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Grid Width="96">
                    <Button x:Name="NotSaved" AutomationProperties.Name="Not saved" Click="OnSave" Style="{StaticResource StatusButtonStyle}" ToolTipService.ToolTip="Save (Ctrl+S)" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Not saved" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Button MinWidth="96" Click="OnGoToLine" Style="{StaticResource StatusButtonStyle}" ToolTipService.ToolTip="Go to line (Ctrl+G)">
                    <TextBlock x:Name="CaretText" Style="{StaticResource CaptionTextBlockStyle}" Text="Ln 1, Col 1" Typography.NumeralAlignment="Tabular" />
                </Button>
                <Rectangle Style="{StaticResource StatusDividerStyle}" />
                <TextBlock x:Name="Words" MinWidth="88" Style="{StaticResource StatusTextStyle}" TextAlignment="Center" />
                <Rectangle Style="{StaticResource StatusDividerStyle}" />
                <Button MinWidth="96" Click="OnGoToPage" Style="{StaticResource StatusButtonStyle}" ToolTipService.ToolTip="Go to page (Ctrl+Alt+G)">
                    <TextBlock x:Name="PageText" Style="{StaticResource CaptionTextBlockStyle}" Text="No PDF" Typography.NumeralAlignment="Tabular" />
                </Button>
                <Rectangle Style="{StaticResource StatusDividerStyle}" />
                <StackPanel x:Name="ZoomBar" Margin="4,0,0,0" Orientation="Horizontal" Spacing="2">
                    <RepeatButton AutomationProperties.Name="Zoom out" Click="{x:Bind Pdf.ZoomOut}" Style="{StaticResource ZoomStepStyle}" ToolTipService.ToolTip="Zoom out (Ctrl+-)">
                        <FontIcon FontSize="12" Glyph="&#xE738;" />
                    </RepeatButton>
                    <Slider
                        x:Name="ZoomSlider"
                        Width="112"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Zoom"
                        IsThumbToolTipEnabled="False"
                        Maximum="2"
                        Minimum="-2"
                        StepFrequency="0.01"
                        ValueChanged="OnZoomSlider"
                        Visibility="Collapsed" />
                    <RepeatButton AutomationProperties.Name="Zoom in" Click="{x:Bind Pdf.ZoomIn}" Style="{StaticResource ZoomStepStyle}" ToolTipService.ToolTip="Zoom in (Ctrl+=)">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                    </RepeatButton>
                    <Button MinWidth="56" Flyout="{x:Bind Pdf.ZoomMenu}" Style="{StaticResource StatusButtonStyle}" ToolTipService.ToolTip="Zoom">
                        <TextBlock x:Name="ZoomText" Style="{StaticResource CaptionTextBlockStyle}" Text="100%" Typography.NumeralAlignment="Tabular" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
