<Page
    x:Class="TeXLocal.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:TeXLocal"
    xmlns:bridge="using:TeXLocal.Bridge"
    xmlns:controls="using:TeXLocal.Controls"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            MaxWidth="1064"
            Padding="36,24,36,0"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Settings" />

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="1064" Padding="36,0,36,36" Spacing="4">
                <!-- Windows Settings brings its cards in one after another. -->
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="Appearance" />
                <controls:Card Glyph="&#xE790;" Header="App theme">
                    <controls:Card.Description>
                        <HyperlinkButton Padding="0" Content="Windows colour settings" FontSize="12" NavigateUri="ms-settings:colors" />
                    </controls:Card.Description>
                    <ComboBox x:Name="ThemeBox" MinWidth="200" AutomationProperties.Name="App theme">
                        <x:String>Use system setting</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </ComboBox>
                </controls:Card>

                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="Projects" />
                <controls:Card Glyph="&#xE8B7;" Header="Projects folder">
                    <controls:Card.Description>
                        <TextBlock
                            Text="{x:Bind bridge:Core.DefaultDataDir}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind bridge:Core.DefaultDataDir}" />
                    </controls:Card.Description>
                    <Button Click="OnOpenFolder" Content="Open in File Explorer" />
                </controls:Card>

                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="TeX" />
                <!-- Collapsed while closed, so a closed bar leaves no gap. -->
                <InfoBar
                    x:Name="TexMissing"
                    Title="TeX isn't installed"
                    IsClosable="False"
                    Message="TeXLocal compiles with TeX Live."
                    Severity="Warning"
                    Visibility="{x:Bind TexMissing.IsOpen, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <HyperlinkButton Content="Get TeX Live" NavigateUri="https://tug.org/texlive/windows.html" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <controls:Card Glyph="&#xE838;" Header="TeX location">
                    <controls:Card.Description>
                        <TextBlock
                            x:Name="TexText"
                            Text="Looking for TeX…"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind TexText.Text, Mode=OneWay}" />
                    </controls:Card.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AutomaticButton" Click="OnAutomatic" Content="Use automatic" Visibility="Collapsed" />
                        <Button Click="OnChooseTex" Content="Choose folder…" />
                    </StackPanel>
                </controls:Card>

                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="Editor" />
                <controls:Card Glyph="&#xE8D2;" Header="Font">
                    <ComboBox x:Name="FontBox" MinWidth="200" AutomationProperties.Name="Font" />
                </controls:Card>
                <controls:Card Glyph="&#xE8E9;" Header="Font size">
                    <ComboBox x:Name="SizeBox" MinWidth="200" AutomationProperties.Name="Font size" />
                </controls:Card>
                <controls:Card Description="Colours for commands, maths and comments, in light and dark" Glyph="&#xE771;" Header="Theme">
                    <ComboBox
                        x:Name="SyntaxBox"
                        MinWidth="200"
                        AutomationProperties.Name="Editor theme"
                        DisplayMemberPath="Title"
                        SelectedValuePath="Id" />
                </controls:Card>
                <Border
                    Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Grid>
                        <!-- The editor's background, current line and secondary text, which the core makes the colours legible on. -->
                        <Rectangle x:Name="PaperInk" Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="Collapsed" />
                        <Rectangle x:Name="LineInk" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed" />
                        <Rectangle x:Name="SecondaryInk" Fill="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                        <TextBlock x:Name="Preview" TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <controls:Card Description="Typing (, [ or { adds its partner" Glyph="&#xE943;" Header="Close brackets automatically">
                    <ToggleSwitch MinWidth="0" AutomationProperties.Name="Close brackets automatically" IsOn="{x:Bind app:Prefs.AutoPair, Mode=TwoWay}" />
                </controls:Card>
                <controls:Card Description="When off, press Ctrl+Space to see suggestions" Glyph="&#xE8FD;" Header="Suggest completions while typing">
                    <ToggleSwitch MinWidth="0" AutomationProperties.Name="Suggest completions while typing" IsOn="{x:Bind app:Prefs.AutoComplete, Mode=TwoWay}" />
                </controls:Card>

                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="About" />
                <controls:Card x:Name="About" Glyph="&#xE946;" Header="TeXLocal" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
