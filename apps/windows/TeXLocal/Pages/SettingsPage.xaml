<Page
    x:Class="TeXLocal.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Style="{StaticResource ContentCardStyle}">
        <ScrollViewer>
            <StackPanel
                MaxWidth="1064"
                Padding="36,0,36,36"
                Spacing="4">
                <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

                <TextBlock Margin="1,30,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Appearance" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="20" Glyph="&#xE790;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="App theme" />
                        <HyperlinkButton
                            Margin="-12,0,0,0"
                            Padding="12,2"
                            Content="Windows colour settings"
                            NavigateUri="ms-settings:colors" />
                    </StackPanel>
                    <ComboBox
                        x:Name="ThemeBox"
                        Grid.Column="2"
                        MinWidth="200"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="App theme"
                        SelectionChanged="OnTheme">
                        <x:String>Use system setting</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </ComboBox>
                </Grid>

                <TextBlock Margin="1,30,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Projects" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="20" Glyph="&#xE8B7;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Projects folder" />
                        <TextBlock
                            x:Name="FolderText"
                            ToolTipService.ToolTip="{x:Bind FolderText.Text}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="OnOpenFolder"
                        Content="Open in File Explorer" />
                </Grid>

                <TextBlock Margin="1,30,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" Text="TeX" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        x:Name="TexIcon"
                        FontSize="20"
                        Glyph="&#xE946;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TexTitle" Style="{StaticResource BodyTextBlockStyle}" Text="Looking for TeX…" />
                        <TextBlock
                            x:Name="TexDetail"
                            ToolTipService.ToolTip="{x:Bind TexDetail.Text, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                    <HyperlinkButton
                        x:Name="TexLink"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Content="Get TeX Live"
                        NavigateUri="https://tug.org/texlive/windows.html"
                        Visibility="Collapsed" />
                </Grid>
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="20" Glyph="&#xE838;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Location" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Where TeXLocal finds latexmk"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="LocationBox"
                        Grid.Column="2"
                        MinWidth="200"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="TeX location"
                        SelectionChanged="OnLocation">
                        <x:String>Automatic</x:String>
                        <x:String>Custom folder</x:String>
                    </ComboBox>
                </Grid>

                <TextBlock Margin="1,30,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Editor" />
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="20" Glyph="&#xE8D2;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Font" />
                    <ComboBox
                        x:Name="FontBox"
                        Grid.Column="2"
                        MinWidth="200"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Font"
                        SelectionChanged="OnFont" />
                </Grid>
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="20" Glyph="&#xE8E9;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Font size" />
                    <ComboBox
                        x:Name="SizeBox"
                        Grid.Column="2"
                        MinWidth="200"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Font size"
                        SelectionChanged="OnFontSize" />
                </Grid>
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="20" Glyph="&#xE771;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Theme" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Colours for commands, maths and comments, in light and dark"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="SyntaxBox"
                        Grid.Column="2"
                        MinWidth="200"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Editor theme"
                        SelectionChanged="OnSyntaxTheme" />
                </Grid>
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- The editor's background and current line, which the core makes the colours legible on. -->
                    <Grid Visibility="Collapsed">
                        <Rectangle x:Name="PaperInk" Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                        <Rectangle x:Name="LineInk" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                        <Rectangle x:Name="SecondaryInk" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <TextBlock
                        x:Name="Preview"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Preview"
                        TextWrapping="Wrap" />
                </Grid>
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="20" Glyph="&#xE765;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Close brackets automatically" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Typing (, [ or { adds its partner"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="PairSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Close brackets automatically"
                        Toggled="OnAutoPair" />
                </Grid>
                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="20" Glyph="&#xE765;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Suggest completions while typing" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="When off, press Ctrl+Space to see suggestions"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="CompleteSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Suggest completions while typing"
                        Toggled="OnAutoComplete" />
                </Grid>

                <TextBlock Margin="1,30,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" Text="About" />
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid Padding="0,16" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="20"
                                Height="20"
                                Source="ms-appx:///Assets/TeXLocal.png" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="TeXLocal" />
                                <TextBlock
                                    x:Name="VersionText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Padding="36,0,0,0" Spacing="4">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="A local LaTeX editor with live preview." />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Licensed under the MIT License." />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
