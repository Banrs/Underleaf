<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TeXLocal.LogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TeXLocal">
    <!-- The panel below the editors, shown and hidden as VS Code's is: the
         build's issues, or its whole log. -->
    <UserControl.Resources>
        <!-- The header's icon buttons, 40 × 32, subtle as a toolbar's are; a
             switched-on toggle takes App.xaml's subtle checked fill. -->
        <Style x:Key="PanelIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EmptyGlyphStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        </Style>
        <Style x:Key="EmptyTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="EmptyDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <!-- 48 tall, as the pane toolbars are. -->
            <Grid Padding="12,0" ColumnSpacing="8" Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- A SelectorBar at its own size, 48 with its padding, fills the row. -->
                <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
                    <SelectorBarItem x:Name="IssuesTab" Text="Issues" />
                    <SelectorBarItem x:Name="LogTab" Text="Build log" />
                </SelectorBar>
                <!-- How the build went; it gives way first when the panel is narrow. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="4,0,0,0" VerticalAlignment="Center">
                    <FontIcon x:Name="SuccessIcon" Glyph="&#xEC61;" FontSize="16" Visibility="Collapsed"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <FontIcon x:Name="FailureIcon" Glyph="&#xEB90;" FontSize="16" Visibility="Collapsed"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="OutcomeText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                    <FontIcon x:Name="WarningIcon" Glyph="&#xE7BA;" FontSize="16" Visibility="Collapsed"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="WarningText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="DurationText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ToggleButton x:Name="WarningsToggle" Grid.Column="2" Width="40" Height="32" Padding="0" VerticalAlignment="Center"
                              IsChecked="True" Click="OnToggleWarnings"
                              AutomationProperties.Name="Hide warnings" ToolTipService.ToolTip="Hide warnings">
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" />
                </ToggleButton>
                <Button x:Name="CopyButton" Grid.Column="2" Style="{StaticResource PanelIconButtonStyle}" Visibility="Collapsed" Click="OnCopy"
                        AutomationProperties.Name="Copy log" ToolTipService.ToolTip="Copy log">
                    <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                </Button>
                <TextBox x:Name="FilterBox" Grid.Column="3" Width="180" VerticalAlignment="Center" PlaceholderText="Filter"
                         IsSpellCheckEnabled="False" AutomationProperties.Name="Filter issues" TextChanged="OnFilterChanged" />
                <Button Grid.Column="4" Style="{StaticResource PanelIconButtonStyle}" Click="OnClose"
                        ToolTipService.ToolTip="Hide panel (Ctrl+Shift+L)" AutomationProperties.Name="Hide panel">
                    <FontIcon Glyph="&#xE711;" FontSize="16" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ListView x:Name="Issues" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnIssueClick"
                      AutomationProperties.Name="Issues">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LogRow">
                        <Grid ColumnSpacing="12" Padding="0,4" AutomationProperties.Name="{x:Bind AccessibleName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Two icons rather than a bound colour, so a contrast theme recolours them. -->
                            <FontIcon Glyph="&#xEB90;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="16"
                                      VerticalAlignment="Top" Margin="0,2,0,0" Visibility="{x:Bind ErrorVisibility}" />
                            <FontIcon Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="16"
                                      VerticalAlignment="Top" Margin="0,2,0,0" Visibility="{x:Bind WarningVisibility}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" MaxLines="3" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{x:Bind Location}" Visibility="{x:Bind LocationVisibility}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- The log as a read-only text box: one selection across lines, as
                 a text view gives, and a text engine that keeps a megabyte log
                 responsive where a TextBlock would lay it all out. Drawn as the
                 pane's own text rather than as a field. -->
            <TextBox x:Name="LogText" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="16,8" BorderThickness="0"
                     IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Build log" Loaded="OnLogLoaded">
                <TextBox.Resources>
                    <StaticResource x:Key="TextControlBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="ControlFillColorTransparentBrush" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
            </TextBox>

            <!-- What's missing, said where the list or log would be. -->
            <StackPanel x:Name="EmptyState" Spacing="8" Margin="24,12" MaxWidth="360"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon x:Name="EmptyGlyph" Style="{StaticResource EmptyGlyphStyle}" />
                <StackPanel>
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource EmptyTitleStyle}" />
                    <TextBlock x:Name="EmptyDetail" Style="{StaticResource EmptyDetailStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
