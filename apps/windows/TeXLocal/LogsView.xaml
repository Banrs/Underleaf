<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TeXLocal.LogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TeXLocal">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="8,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Name="IssuesTab" Text="Issues" />
                <SelectorBarItem x:Name="RawTab" Text="Raw log" />
            </SelectorBar>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon x:Name="SuccessIcon" Glyph="&#xE73E;" FontSize="16" Visibility="Collapsed"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                <FontIcon x:Name="FailureIcon" Glyph="&#xEB90;" FontSize="16" Visibility="Collapsed"
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <TextBlock x:Name="OutcomeText" />
                <TextBlock x:Name="DurationText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="2" Click="OnClose" ToolTipService.ToolTip="Close the log (Ctrl+Shift+L)"
                    AutomationProperties.Name="Close the log" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="Issues" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnIssueClick"
                      AutomationProperties.Name="Issues">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LogRow">
                        <Grid ColumnSpacing="12" Padding="0,8" AutomationProperties.Name="{x:Bind AccessibleName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Two icons rather than a bound colour, so a contrast theme recolours them. -->
                            <FontIcon Glyph="&#xEB90;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="16"
                                      VerticalAlignment="Top" Margin="0,2,0,0" Visibility="{x:Bind ErrorVisibility}" />
                            <FontIcon Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="16"
                                      VerticalAlignment="Top" Margin="0,2,0,0" Visibility="{x:Bind WarningVisibility}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{x:Bind Location}" Visibility="{x:Bind LocationVisibility}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="NoIssues" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ScrollViewer x:Name="Raw" Visibility="Collapsed" Padding="12,8"
                          HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
                <TextBlock x:Name="RawText" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True"
                           AutomationProperties.Name="Raw log" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
