<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TeXLocal.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///SubtleToggles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SplitterRuleStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <!-- The pane toolbars are rows of standard buttons, 48 tall as the
                 title bar and a CommandBar are, with the buttons 8 apart as
                 Microsoft spaces them. Their icon-only buttons are the app's
                 usual 40 × 32 subtle button, as Photos has them, and their
                 groups are divided by a 24 px rule. -->
            <Style x:Key="ToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="ToolbarSeparatorStyle" TargetType="Rectangle">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="24" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
