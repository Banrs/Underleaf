<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Toggles are subtle, as File Explorer's toolbar has them: clear at
         rest, SubtleFillColorSecondary on hover and when switched on (a pane
         shown, warnings listed), Tertiary when pressed, and no accent block.
         Every toggle in the app is a toolbar toggle, so this is said once
         here. Brushes of their own, because aliases of the theme brushes were
         ignored. Contrast themes keep the system's own colours, so they have
         no entry. App.xaml merges this, and so does the title bar's toggle
         group, whose toggles didn't pick it up from the app's resources. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#09000000" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#06000000" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#06000000" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E4000000" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#E4000000" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#9E000000" />
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#09000000" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#06000000" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast" />
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
