<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TeXLocal.InspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The details pane, as File Explorer's sits beside its content (and
         Photos' file info, and Visual Studio's Properties): what's open at
         the top, then the project's build settings as header-over-control
         fields, then the document's and the PDF's properties as label/value
         rows. No chrome but the headings. Spacing from the guidance: 16 px
         between the surface and its text, 12 px between content areas, each
         control's own header gap; sections 24 apart; property rows 4 apart,
         the label in Caption, as Explorer labels its properties. -->
    <UserControl.Resources>
        <Style x:Key="FactLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FactValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </UserControl.Resources>

    <!-- What's open in the two rows the panes beside it have: its name in
         the 48 px toolbar row, where it lives in the 32 px location row, and
         the location row's divider carried across. Then the properties,
         scrolling beneath. -->
    <Grid AutomationProperties.Name="Details pane">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="16,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="ItemGlyph" Glyph="&#xE8A5;" FontSize="16" VerticalAlignment="Center"
                      AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="ItemName" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
        </Grid>
        <Grid Grid.Row="1" Padding="16,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="ItemFolder" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16" Spacing="24">
                <StackPanel x:Name="BuildSection" Spacing="12">
                    <TextBlock Text="Build" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="MainFileBox" Header="Main file" HorizontalAlignment="Stretch"
                              SelectionChanged="OnMainFileChanged" />
                    <ComboBox x:Name="EngineBox" Header="Engine" HorizontalAlignment="Stretch"
                              SelectionChanged="OnEngineChanged" />
                    <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="ShellEscapeSwitch" Header="Shell escape" Toggled="OnShellEscapeToggled" />
                        <TextBlock Text="Lets packages such as minted run programs. Turn on only for projects you trust."
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoCompileSwitch" Header="Compile automatically" Toggled="OnAutoCompileToggled" />
                </StackPanel>

                <StackPanel x:Name="DocumentSection" Spacing="12">
                    <TextBlock Text="Document" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid x:Name="DocumentFacts" ColumnSpacing="12" RowSpacing="4" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="PDF" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid x:Name="PdfFacts" ColumnSpacing="12" RowSpacing="4" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
