<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TeXLocal.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A settings card with the Windows Community Toolkit's SettingsCard
             metrics: MinHeight 68, padding 16, radius 4, a 20 px icon with
             2,0,20,0 around it, the header 24 clear of the control, and the
             control at least 120 wide. -->
        <Style x:Key="Card" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinHeight" Value="68" />
        </Style>
        <Style x:Key="CardIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="2,0,20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardHeader" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,24,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- A row inside an expander card, with SettingsExpander's item
             metrics: its text lines up under the header's, a 1 px line above. -->
        <Style x:Key="ExpanderItem" TargetType="Grid">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="58,8,44,8" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="ColumnSpacing" Value="24" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style>
    </UserControl.Resources>

    <!-- The WinUI Gallery's settings page: the title outside the scrolling
         column, both at most 1064 wide and centred. -->
    <Grid KeyDown="OnKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="36,24,36,0" MaxWidth="1064" />

        <!-- The column is centred inside a full-width grid: given straight to
             the ScrollViewer, a column with a MaxWidth was placed off-centre. -->
        <ScrollViewer Grid.Row="1">
        <Grid>
        <StackPanel MaxWidth="1064" Margin="36,0,36,36" Spacing="4">
            <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE790;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" Style="{StaticResource CardHeader}">
                    <TextBlock Text="App theme" />
                    <TextBlock Text="Light, dark, or the same as Windows" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="120" VerticalAlignment="Center"
                          AutomationProperties.Name="App theme" SelectionChanged="OnSelectionChanged">
                    <x:String>Use system setting</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8E9;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" Style="{StaticResource CardHeader}">
                    <TextBlock Text="Editor size" />
                    <TextBlock Text="Scales the editor, on top of the text size you set in Windows" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <ComboBox x:Name="ScaleBox" Grid.Column="2" MinWidth="120" VerticalAlignment="Center"
                          AutomationProperties.Name="Editor size" SelectionChanged="OnSelectionChanged" />
            </Grid>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xEA90;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" Style="{StaticResource CardHeader}">
                    <TextBlock Text="PDF paper" />
                    <TextBlock Text="Dark inverts the pages' colors for reading at night" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <ComboBox x:Name="PaperBox" Grid.Column="2" MinWidth="120" VerticalAlignment="Center"
                          AutomationProperties.Name="PDF paper" SelectionChanged="OnSelectionChanged">
                    <x:String>White</x:String>
                    <x:String>Dark</x:String>
                    <x:String>Match app theme</x:String>
                </ComboBox>
            </Grid>

            <TextBlock Text="Editor" Style="{StaticResource SectionHeader}" />
            <!-- SettingsExpander's metrics on the WinUI Expander: the header a
                 68 px card whose icon and text sit where a card's do (the
                 Expander pads its header 16 on the left), and the rows below
                 with no padding of the Expander's own. -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="68" Padding="0"
                      IsExpanded="True" AutomationProperties.Name="Text">
                <Expander.Header>
                    <Grid Padding="0,16,4,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D2;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" Style="{StaticResource CardHeader}">
                            <TextBlock Text="Text" />
                            <TextBlock Text="Syntax colors, font, and font size" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <Grid Style="{StaticResource ExpanderItem}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Syntax colors" VerticalAlignment="Center" />
                        <ComboBox x:Name="PaletteBox" Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                                  AutomationProperties.Name="Syntax colors" SelectionChanged="OnSelectionChanged">
                            <x:String>One Dark</x:String>
                            <x:String>Xcode</x:String>
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource ExpanderItem}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Font" VerticalAlignment="Center" />
                        <ComboBox x:Name="FontBox" Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                                  AutomationProperties.Name="Font" SelectionChanged="OnSelectionChanged">
                            <x:String>System monospace</x:String>
                            <x:String>JetBrains Mono</x:String>
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource ExpanderItem}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Font size" VerticalAlignment="Center" />
                        <NumberBox x:Name="SizeBox" Grid.Column="1" MinWidth="120" VerticalAlignment="Center" Minimum="10" Maximum="28"
                                   SpinButtonPlacementMode="Inline" AutomationProperties.Name="Font size"
                                   ValueChanged="OnSizeChanged" />
                    </Grid>
                </StackPanel>
            </Expander>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8FD;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" Style="{StaticResource CardHeader}">
                    <TextBlock Text="Word count" />
                    <TextBlock Text="Show words and lines in the status bar" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <!-- A switch keeps its own width, as SettingsCard leaves it. -->
                <ToggleSwitch x:Name="WordCountSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center"
                              AutomationProperties.Name="Word count" Toggled="OnToggled" />
            </Grid>

            <TextBlock Text="Compiling" Style="{StaticResource SectionHeader}" />
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE768;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" Style="{StaticResource CardHeader}">
                    <TextBlock Text="Compile automatically" />
                    <TextBlock Text="Save and compile when you stop typing" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <ToggleSwitch x:Name="AutoCompileSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center"
                              AutomationProperties.Name="Compile automatically" Toggled="OnToggled" />
            </Grid>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE9F5;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" Style="{StaticResource CardHeader}">
                    <TextBlock Text="TeX engine" />
                    <TextBlock x:Name="EngineDescription" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <ComboBox x:Name="EngineBox" Grid.Column="2" MinWidth="120" VerticalAlignment="Center"
                          AutomationProperties.Name="TeX engine" SelectionChanged="OnEngineChanged">
                    <x:String>pdfLaTeX</x:String>
                    <x:String>XeLaTeX</x:String>
                    <x:String>LuaLaTeX</x:String>
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE946;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" Style="{StaticResource CardHeader}">
                    <TextBlock Text="TeX distribution" />
                    <TextBlock x:Name="TexDescription" Style="{StaticResource CardDescription}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <HyperlinkButton x:Name="GetTex" Content="Get MiKTeX" NavigateUri="https://miktex.org/download" />
                    <Button x:Name="AutomaticTex" Content="Use automatic" Click="OnAutomaticTex"
                            ToolTipService.ToolTip="Find TeX by itself again" />
                    <Button Content="Browse…" Click="OnBrowseTex" AutomationProperties.Name="Choose the TeX folder"
                            ToolTipService.ToolTip="Choose the folder with TeX’s programs, the one that contains latexmk" />
                </StackPanel>
            </Grid>

            <!-- As the WinUI Gallery ends its settings: the app, its version, and
                 what it is. -->
            <TextBlock Text="About" Style="{StaticResource SectionHeader}" />
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="AboutIcon" Width="20" Height="20" Margin="2,0,20,0" VerticalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1" Style="{StaticResource CardHeader}">
                    <TextBlock Text="TeXLocal" />
                    <TextBlock Text="A LaTeX editor that works on this PC. Your files never leave it." Style="{StaticResource CardDescription}" />
                </StackPanel>
                <TextBlock x:Name="VersionText" Grid.Column="2" VerticalAlignment="Center" IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </StackPanel>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
