<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TeXLocal.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A settings card as Windows 11 Settings draws one: icon, header and
             description on the left, the control on the right. -->
        <Style x:Key="Card" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
        <Style x:Key="CardIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="4,28,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="56,8,56,40" Spacing="4" KeyDown="OnKeyDown">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

            <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE790;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="App theme" />
                    <TextBlock Text="Light, dark, or the same as Windows" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                          AutomationProperties.Name="App theme" SelectionChanged="OnSelectionChanged">
                    <x:String>Use system setting</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8E9;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Editor size" />
                    <TextBlock Text="Scales the editor, on top of the text size you set in Windows" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <ComboBox x:Name="ScaleBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                          AutomationProperties.Name="Editor size" SelectionChanged="OnSelectionChanged" />
            </Grid>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xEA90;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="PDF paper" />
                    <TextBlock Text="Dark inverts the pages' colors for reading at night" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <ComboBox x:Name="PaperBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                          AutomationProperties.Name="PDF paper" SelectionChanged="OnSelectionChanged">
                    <x:String>White</x:String>
                    <x:String>Dark</x:String>
                    <x:String>Match app theme</x:String>
                </ComboBox>
            </Grid>

            <TextBlock Text="Editor" Style="{StaticResource SectionHeader}" />
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True"
                      AutomationProperties.Name="Text">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,12" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D2;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Text" />
                            <TextBlock Text="Syntax colors, font, and font size" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="12" Padding="40,0,0,0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Syntax colors" VerticalAlignment="Center" />
                        <ComboBox x:Name="PaletteBox" Grid.Column="1" MinWidth="200"
                                  AutomationProperties.Name="Syntax colors" SelectionChanged="OnSelectionChanged">
                            <x:String>One Dark</x:String>
                            <x:String>Xcode</x:String>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Font" VerticalAlignment="Center" />
                        <ComboBox x:Name="FontBox" Grid.Column="1" MinWidth="200"
                                  AutomationProperties.Name="Font" SelectionChanged="OnSelectionChanged">
                            <x:String>System monospace</x:String>
                            <x:String>JetBrains Mono</x:String>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Font size" VerticalAlignment="Center" />
                        <NumberBox x:Name="SizeBox" Grid.Column="1" MinWidth="200" Minimum="10" Maximum="28"
                                   SpinButtonPlacementMode="Inline" AutomationProperties.Name="Font size"
                                   ValueChanged="OnSizeChanged" />
                    </Grid>
                </StackPanel>
            </Expander>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8FD;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Word count" />
                    <TextBlock Text="Show words and lines in the status bar" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <ToggleSwitch x:Name="WordCountSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center"
                              AutomationProperties.Name="Word count" Toggled="OnToggled" />
            </Grid>

            <TextBlock Text="Compiling" Style="{StaticResource SectionHeader}" />
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE768;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Compile automatically" />
                    <TextBlock Text="Save and compile when you stop typing" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <ToggleSwitch x:Name="AutoCompileSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center"
                              AutomationProperties.Name="Compile automatically" Toggled="OnToggled" />
            </Grid>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE9F5;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="TeX engine" />
                    <TextBlock x:Name="EngineDescription" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <ComboBox x:Name="EngineBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                          AutomationProperties.Name="TeX engine" SelectionChanged="OnEngineChanged">
                    <x:String>pdfLaTeX</x:String>
                    <x:String>XeLaTeX</x:String>
                    <x:String>LuaLaTeX</x:String>
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE946;" Style="{StaticResource CardIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="TeX distribution" />
                    <TextBlock x:Name="TexDescription" Style="{StaticResource CardDescription}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <HyperlinkButton x:Name="GetTex" Grid.Column="2" VerticalAlignment="Center"
                                 Content="Get MiKTeX" NavigateUri="https://miktex.org/download" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
