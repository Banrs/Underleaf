<InfoBar
    x:Class="TeXLocal.Controls.TexBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TeX isn't installed"
    IsClosable="False"
    Message="Install TinyTeX to compile, or get TeX Live, the full TeX distribution."
    Severity="Warning">
    <InfoBar.ActionButton>
        <Button x:Name="Install" AutomationProperties.Name="{x:Bind InstallText.Text, Mode=OneWay}" Click="OnInstall">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing x:Name="Ring" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="InstallText" Text="Install TinyTeX" />
            </StackPanel>
        </Button>
    </InfoBar.ActionButton>
    <HyperlinkButton Margin="0,0,0,8" Content="Get TeX Live" NavigateUri="https://tug.org/texlive/windows.html" />
</InfoBar>
