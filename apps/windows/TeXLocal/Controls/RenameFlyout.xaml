<Flyout
    x:Class="TeXLocal.Controls.RenameFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Placement="BottomEdgeAlignedLeft">
    <StackPanel Width="280" Spacing="8">
        <TextBox x:Name="Box" AutomationProperties.Name="Name" KeyDown="OnKeyDown" TextChanged="OnTextChanged" />
        <Button x:Name="Commit" HorizontalAlignment="Right" Click="OnCommit" Content="Rename" Style="{StaticResource AccentButtonStyle}" />
    </StackPanel>
</Flyout>
