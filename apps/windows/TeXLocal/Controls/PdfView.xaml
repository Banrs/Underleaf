<UserControl
    x:Class="TeXLocal.Controls.PdfView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
        <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xEA90;" />
            <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="No PDF yet" />
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyTextBlockStyle}" Text="Compile to see the PDF here." />
            <HyperlinkButton x:Name="GetTex" HorizontalAlignment="Center" Content="Get TeX Live" NavigateUri="https://tug.org/texlive/windows.html" Visibility="Collapsed" />
        </StackPanel>

        <ScrollViewer
            x:Name="Scroller"
            AutomationProperties.Name="PDF"
            ContextRequested="OnContextRequested"
            HorizontalScrollBarVisibility="Auto"
            IsTabStop="True"
            MaxZoomFactor="4"
            MinZoomFactor="0.25"
            ZoomMode="Enabled">
            <!--  Shown by ContextRequested, so it opens where it acts, from the keyboard too.  -->
            <FlyoutBase.AttachedFlyout>
                <MenuFlyout x:Name="Menu" Opening="OnMenuOpening">
                    <MenuFlyoutItem x:Name="SourceItem" Click="OnGoToSource" Text="Go to source position" />
                    <MenuFlyoutSeparator x:Name="SourceRule" />
                    <MenuFlyoutItem Click="{x:Bind ZoomIn}" KeyboardAcceleratorTextOverride="Ctrl+=" Text="Zoom in">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A3;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Click="{x:Bind ZoomOut}" KeyboardAcceleratorTextOverride="Ctrl+-" Text="Zoom out">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71F;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <RadioMenuFlyoutItem x:Name="FitWidthItem" Click="{x:Bind FitWidth}" GroupName="Zoom" Text="Fit width" />
                    <RadioMenuFlyoutItem x:Name="FitPageItem" Click="{x:Bind FitPage}" GroupName="Zoom" Text="Fit page" />
                    <MenuFlyoutSeparator />
                </MenuFlyout>
            </FlyoutBase.AttachedFlyout>
            <!--  Padding, not Margin, so the content's coordinates are the panel's. Light: white paper in both themes.  -->
            <StackPanel x:Name="Pages" Padding="12" HorizontalAlignment="Center" RequestedTheme="Light" Spacing="12">
                <StackPanel.Resources>
                    <!--  The paper: its stroke falls outside the page, so the bitmap keeps its size.  -->
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}" />
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                    </Style>
                    <SolidColorBrush x:Key="SyncFill" Opacity="0.3" Color="{ThemeResource SystemAccentColor}" />
                    <Style TargetType="Rectangle">
                        <Setter Property="Fill" Value="{StaticResource SyncFill}" />
                        <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Property="RadiusX" Value="4" />
                        <Setter Property="RadiusY" Value="4" />
                    </Style>
                </StackPanel.Resources>
            </StackPanel>
        </ScrollViewer>

        <ProgressBar x:Name="Progress" VerticalAlignment="Top" AutomationProperties.Name="Compiling" IsIndeterminate="True" Visibility="Collapsed" />
    </Grid>
</UserControl>
