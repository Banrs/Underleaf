<UserControl
    x:Class="TeXLocal.Controls.SourceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TeXLocal.Controls">

    <UserControl.Resources>
        <!-- A flyout's surface, for the popups that leave the keyboard in the editor. -->
        <Style x:Key="SurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        </Style>
        <Style x:Key="FindButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="CompletionItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="12,0,16,0" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
        </Style>
        <DataTemplate x:Key="IssueTemplate" x:DataType="local:IssueMark">
            <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Tip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <InfoBadge VerticalAlignment="Center" Style="{x:Bind Badge}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Label}"
                    TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Visibility="Collapsed">
            <Rectangle x:Name="PaperInk" Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Rectangle x:Name="TextInk" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
            <Rectangle x:Name="SecondaryInk" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
            <Rectangle x:Name="NumberInk" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <Canvas x:Name="Gutter" />
        <Canvas x:Name="Backdrop" Grid.Column="1" AutomationProperties.AccessibilityView="Raw">
            <Rectangle x:Name="CurrentLine" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
        </Canvas>
        <RichEditBox
            x:Name="Editor"
            Grid.Column="1"
            Padding="8,8,16,8"
            AutomationProperties.Name="Source"
            ClipboardCopyFormat="PlainText"
            DisabledFormattingAccelerators="All"
            IsSpellCheckEnabled="False"
            IsTextPredictionEnabled="False"
            SelectionHighlightColorWhenNotFocused="{ThemeResource TextControlSelectionHighlightColor}">
            <!-- No border in any state, so its brushes are never drawn. -->
            <RichEditBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            </RichEditBox.Resources>
        </RichEditBox>
        <Canvas x:Name="Overlay" Grid.Column="1">
            <Border
                x:Name="PartnerBox"
                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                IsHitTestVisible="False"
                Opacity="0" />
        </Canvas>

        <!-- Notepad's find bar over the text, with VS Code's find widget's behaviour; narrow, it may cover the gutter. -->
        <Border
            x:Name="FindBar"
            Grid.ColumnSpan="2"
            Margin="0,8,24,0"
            Padding="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Style="{StaticResource SurfaceStyle}"
            Translation="0,0,32"
            Visibility="Collapsed">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid ColumnSpacing="4" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" MinWidth="64" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ReplaceToggle"
                    AutomationProperties.Name="Toggle replace"
                    Click="OnReplaceToggle"
                    Style="{StaticResource FindButtonStyle}"
                    ToolTipService.ToolTip="Toggle replace (Ctrl+H)">
                    <FontIcon x:Name="ReplaceChevron" FontSize="12" Glyph="&#xE76C;" />
                </Button>
                <TextBox
                    x:Name="FindBox"
                    Grid.Column="1"
                    AutomationProperties.Name="Find"
                    KeyDown="OnFindKeyDown"
                    PlaceholderText="Find"
                    TextChanged="OnFindChanged" />
                <TextBlock
                    x:Name="FindCount"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="NoWrap"
                    Typography.NumeralAlignment="Tabular" />
                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Find previous"
                    Click="OnFindPrevious"
                    Style="{StaticResource FindButtonStyle}"
                    ToolTipService.ToolTip="Find previous (Shift+F3)">
                    <FontIcon FontSize="16" Glyph="&#xE74A;" />
                </Button>
                <Button
                    Grid.Column="4"
                    AutomationProperties.Name="Find next"
                    Click="OnFindNext"
                    Style="{StaticResource FindButtonStyle}"
                    ToolTipService.ToolTip="Find next (F3)">
                    <FontIcon FontSize="16" Glyph="&#xE74B;" />
                </Button>
                <Button
                    Grid.Column="5"
                    AutomationProperties.Name="Find options"
                    Style="{StaticResource FindButtonStyle}"
                    ToolTipService.ToolTip="Find options">
                    <FontIcon FontSize="16" Glyph="&#xE71C;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <ToggleMenuFlyoutItem x:Name="MatchCase" Click="OnFindChanged" Text="Match case" />
                            <ToggleMenuFlyoutItem x:Name="WholeWord" Click="OnFindChanged" Text="Whole word" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    Grid.Column="6"
                    AutomationProperties.Name="Close"
                    Click="OnFindClose"
                    Style="{StaticResource FindButtonStyle}"
                    ToolTipService.ToolTip="Close (Esc)">
                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                </Button>
                <TextBox
                    x:Name="ReplaceBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    AutomationProperties.Name="Replace"
                    KeyDown="OnFindKeyDown"
                    PlaceholderText="Replace"
                    Visibility="Collapsed" />
                <StackPanel
                    x:Name="ReplaceButtons"
                    Grid.Row="1"
                    Grid.Column="2"
                    Grid.ColumnSpan="5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="Collapsed">
                    <Button x:Name="ReplaceOne" Click="OnReplace" Content="Replace" IsEnabled="False" />
                    <Button x:Name="ReplaceEvery" Click="OnReplaceAll" Content="Replace all" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- VS Code's hover: the maths the caret is in, drawn by RaTeX, above its line. -->
        <Popup x:Name="MathPopup" Grid.Column="1">
            <Popup.ChildTransitions>
                <TransitionCollection>
                    <PopupThemeTransition />
                </TransitionCollection>
            </Popup.ChildTransitions>
            <Border
                x:Name="MathSurface"
                Padding="12,8"
                IsHitTestVisible="False"
                Style="{StaticResource SurfaceStyle}"
                Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid>
                    <Image x:Name="MathImage" AutomationProperties.Name="Maths preview" Stretch="Fill" />
                    <StackPanel x:Name="MathError" Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Top"
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE783;" />
                        <TextBlock x:Name="MathErrorText" MaxWidth="480" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- IntelliSense on the flyout surface: the list never takes the keyboard from the text. -->
        <Popup x:Name="CompletionPopup" Grid.Column="1">
            <Popup.ChildTransitions>
                <TransitionCollection>
                    <PopupThemeTransition />
                </TransitionCollection>
            </Popup.ChildTransitions>
            <Border
                MinWidth="240"
                MaxWidth="480"
                Padding="0,4"
                Style="{StaticResource SurfaceStyle}"
                Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <ListView
                    x:Name="CompletionList"
                    MaxHeight="256"
                    AllowFocusOnInteraction="False"
                    AutomationProperties.Name="Completions"
                    IsItemClickEnabled="True"
                    IsTabStop="False"
                    ItemClick="OnCompletionClick"
                    ItemContainerStyle="{StaticResource CompletionItemStyle}">
                    <ListView.Resources>
                        <x:Double x:Key="ListViewItemMinHeight">32</x:Double>
                    </ListView.Resources>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:CompletionRow">
                            <Grid AutomationProperties.Name="{x:Bind Item.Label}" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind Glyph}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run FontWeight="SemiBold" Text="{x:Bind Typed}" /><Run Text="{x:Bind Rest}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Popup>
    </Grid>
</UserControl>
