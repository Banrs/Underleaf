<UserControl
    x:Class="TeXLocal.Controls.SourceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TeXLocal.Controls">

    <UserControl.Resources>
        <Style x:Key="NumberStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="CurrentNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource NumberStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- A flyout's surface, for the popups that leave the keyboard in the editor. -->
        <Style x:Key="SurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        </Style>
        <DataTemplate x:Key="ErrorBox">
            <Border
                Padding="4,0,8,0"
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xE783;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="WarningBox">
            <Border
                Padding="4,0,8,0"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE7BA;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Visibility="Collapsed">
            <Rectangle x:Name="PaperInk" Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Rectangle x:Name="TextInk" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
            <Rectangle x:Name="SecondaryInk" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Canvas x:Name="Gutter" Width="48" />
        <Canvas x:Name="Backdrop" Grid.Column="1">
            <Rectangle x:Name="CurrentLine" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
        </Canvas>
        <RichEditBox
            x:Name="Editor"
            Grid.Column="1"
            AcceptsReturn="True"
            AutomationProperties.Name="Source"
            ClipboardCopyFormat="PlainText"
            DisabledFormattingAccelerators="All"
            FontFamily="Cascadia Mono, Consolas"
            FontSize="14"
            IsSpellCheckEnabled="False"
            IsTextPredictionEnabled="False"
            TextWrapping="Wrap">
            <RichEditBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            </RichEditBox.Resources>
        </RichEditBox>
        <Canvas x:Name="Overlay" Grid.Column="1">
            <!-- The bracket a closer matches, for a moment. -->
            <Border
                x:Name="PartnerBox"
                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="2"
                IsHitTestVisible="False"
                Opacity="0" />
        </Canvas>

        <!-- Find and replace over the text, as Notepad's. -->
        <Border
            x:Name="FindBar"
            Grid.Column="1"
            Margin="0,8,24,0"
            Padding="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Style="{StaticResource SurfaceStyle}"
            Translation="0,0,16"
            Visibility="Collapsed">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid ColumnSpacing="4" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="96" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ReplaceToggle"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.Name="Show replace"
                    Click="OnReplaceToggle"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Show replace (Ctrl+H)">
                    <FontIcon x:Name="ReplaceChevron" FontSize="12" Glyph="&#xE76C;" />
                </Button>
                <TextBox
                    x:Name="FindBox"
                    Grid.Column="1"
                    AutomationProperties.Name="Find"
                    KeyDown="OnFindKeyDown"
                    PlaceholderText="Find"
                    TextChanged="OnFindChanged" />
                <TextBlock
                    x:Name="FindCount"
                    Grid.Column="2"
                    MinWidth="64"
                    Padding="4,0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextAlignment="Center"
                    Typography.NumeralAlignment="Tabular" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.Name="Find previous"
                        Click="OnFindPrevious"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Find previous (Shift+F3)">
                        <FontIcon FontSize="16" Glyph="&#xE74A;" />
                    </Button>
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.Name="Find next"
                        Click="OnFindNext"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Find next (F3)">
                        <FontIcon FontSize="16" Glyph="&#xE74B;" />
                    </Button>
                </StackPanel>
                <Button
                    Grid.Column="4"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.Name="Find options"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Find options">
                    <FontIcon FontSize="16" Glyph="&#xE71C;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <ToggleMenuFlyoutItem x:Name="MatchCase" Click="OnFindChanged" Text="Match case" />
                            <ToggleMenuFlyoutItem x:Name="WholeWord" Click="OnFindChanged" Text="Whole word" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    Grid.Column="5"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.Name="Close find"
                    Click="OnFindClose"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Close (Esc)">
                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                </Button>
                <TextBox
                    x:Name="ReplaceBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    AutomationProperties.Name="Replace"
                    KeyDown="OnFindKeyDown"
                    PlaceholderText="Replace"
                    Visibility="Collapsed" />
                <StackPanel
                    x:Name="ReplaceButtons"
                    Grid.Row="1"
                    Grid.Column="2"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="Collapsed">
                    <Button Click="OnReplace" Content="Replace" />
                    <Button Click="OnReplaceAll" Content="Replace all" />
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="MathPopup" Grid.Column="1">
            <Border
                x:Name="MathSurface"
                Padding="12,8"
                IsHitTestVisible="False"
                Style="{StaticResource SurfaceStyle}"
                Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid>
                    <Image x:Name="MathImage" AutomationProperties.Name="Maths preview" Stretch="Fill" />
                    <TextBlock
                        x:Name="MathError"
                        MaxWidth="480"
                        FontFamily="Cascadia Mono, Consolas"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Popup>

        <Popup x:Name="CompletionPopup" Grid.Column="1">
            <Border
                x:Name="CompletionSurface"
                MinWidth="240"
                MaxWidth="480"
                Padding="0,4"
                Style="{StaticResource SurfaceStyle}"
                Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <ListView
                    x:Name="CompletionList"
                    AllowFocusOnInteraction="False"
                    AutomationProperties.Name="Completions"
                    IsItemClickEnabled="True"
                    IsTabStop="False"
                    ItemClick="OnCompletionClick"
                    SelectionMode="Single">
                    <ListView.Resources>
                        <x:Double x:Key="ListViewItemMinHeight">32</x:Double>
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="Padding" Value="12,0,16,0" />
                            <Setter Property="AllowFocusOnInteraction" Value="False" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:CompletionRow">
                            <Grid AutomationProperties.Name="{x:Bind Item.Label}" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind Glyph}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="{x:Bind Font}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">
                                    <Run FontWeight="SemiBold" Text="{x:Bind Typed}" /><Run Text="{x:Bind Rest}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Popup>
    </Grid>
</UserControl>
