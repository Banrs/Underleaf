<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TeXLocal.PdfPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnSizeChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Two rows lined up with the source's: a 48 px row of actions —
             Compile, the one accent control, then zoom and Share — and
             beneath it where the reader is. Finding takes the actions row. As
             the pane narrows the row folds as the macOS pane drops controls
             (Fold): the labels first, then the zoom group into "See more",
             Share last. -->
        <Grid x:Name="Bar" Height="48" Padding="8,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="CompileControls" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="CompileButton" Style="{StaticResource AccentButtonStyle}" Height="32" Click="OnCompile" AccessKey="R"
                        AutomationProperties.Name="Compile">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="16" />
                        <TextBlock x:Name="CompileLabel" Text="Compile" />
                    </StackPanel>
                </Button>
                <ProgressRing x:Name="CompileProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed"
                              AutomationProperties.Name="Compiling" />
                <Button x:Name="StopButton" Height="32" Click="OnStop" Visibility="Collapsed" AutomationProperties.Name="Stop"
                        ToolTipService.ToolTip="Stop (Ctrl+Break)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="16" />
                        <TextBlock x:Name="StopLabel" Text="Stop" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel x:Name="ViewTools" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- One control in three parts, so none apart: the level between
                     its − and +, as Photos and Edge's PDF viewer group them. -->
                <StackPanel x:Name="ZoomTools" Orientation="Horizontal">
                    <Button x:Name="ZoomOutButton" Style="{StaticResource ToolbarIconButtonStyle}" Click="OnZoomOut"
                            AutomationProperties.Name="Zoom out" ToolTipService.ToolTip="Zoom out (Ctrl+Minus)">
                        <FontIcon Glyph="&#xE71F;" FontSize="16" />
                    </Button>
                    <!-- Subtle, as the buttons either side are; a fixed width so
                         the group doesn't shift as the level changes. -->
                    <DropDownButton x:Name="ZoomLevel" MinWidth="104" Height="32"
                                    AutomationProperties.Name="Zoom level" ToolTipService.ToolTip="Zoom level">
                        <DropDownButton.Resources>
                            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="ControlFillColorTransparentBrush" />
                        </DropDownButton.Resources>
                        <TextBlock x:Name="ZoomText" Text="Fit width" />
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="ZoomMenu" Placement="BottomEdgeAlignedRight" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="ZoomInButton" Style="{StaticResource ToolbarIconButtonStyle}" Click="OnZoomIn"
                            AutomationProperties.Name="Zoom in" ToolTipService.ToolTip="Zoom in (Ctrl+Plus)">
                        <FontIcon Glyph="&#xE8A3;" FontSize="16" />
                    </Button>
                </StackPanel>
                <Rectangle x:Name="ZoomSeparator" Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button x:Name="ShareButton" Style="{StaticResource SubtleButtonStyle}" Height="32" Click="OnShare"
                        AutomationProperties.Name="Share PDF" ToolTipService.ToolTip="Share the PDF">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72D;" FontSize="16" />
                        <TextBlock x:Name="ShareLabel" Text="Share" />
                    </StackPanel>
                </Button>
                <Button x:Name="PdfMore" Style="{StaticResource ToolbarIconButtonStyle}" Visibility="Collapsed"
                        AutomationProperties.Name="See more" ToolTipService.ToolTip="See more">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="PdfMoreMenu" Placement="BottomEdgeAlignedRight" Opening="OnPdfMoreOpening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <!-- The field takes what the buttons leave, as the Mac's search
                 field does, within a readable width. -->
            <Grid x:Name="FindBar" Grid.ColumnSpan="2" ColumnSpacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FindBox" MinWidth="120" PlaceholderText="Find in PDF" AutomationProperties.Name="Find in PDF"
                         VerticalAlignment="Center" IsSpellCheckEnabled="False"
                         TextChanged="OnFindChanged" KeyDown="OnFindKeyDown" />
                <!-- Read out as it changes, as the count is the search's only answer. -->
                <TextBlock x:Name="FindStatus" Grid.Column="1" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="PreviousMatch" Grid.Column="2" Style="{StaticResource ToolbarIconButtonStyle}" IsEnabled="False"
                        Click="OnPreviousMatch"
                        ToolTipService.ToolTip="Previous match (Shift+Enter)" AutomationProperties.Name="Previous match">
                    <FontIcon Glyph="&#xE70E;" FontSize="16" />
                </Button>
                <Button x:Name="NextMatch" Grid.Column="3" Style="{StaticResource ToolbarIconButtonStyle}" IsEnabled="False"
                        Click="OnNextMatch"
                        ToolTipService.ToolTip="Next match (Enter)" AutomationProperties.Name="Next match">
                    <FontIcon Glyph="&#xE70D;" FontSize="16" />
                </Button>
                <Button Grid.Column="4" Content="Done" Click="OnFindDone" ToolTipService.ToolTip="Done (Esc)" />
            </Grid>
        </Grid>

        <!-- The page, and whether the PDF still matches the source. -->
        <Grid Grid.Row="1" Height="32" Padding="12,0" ColumnSpacing="12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Freshness" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                <FontIcon x:Name="EditedIcon" Glyph="&#xE81C;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                <FontIcon x:Name="FailedIcon" Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="FreshnessText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <!-- Tabular digits, so the label doesn't jitter as pages scroll by. -->
            <TextBlock x:Name="PageLabel" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Grid Grid.Row="2">
            <WebView2 x:Name="View" />
            <StackPanel x:Name="Empty" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEA90;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="EmptyDetail" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="320" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
