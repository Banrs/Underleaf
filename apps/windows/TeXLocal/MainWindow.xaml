<Window
    x:Class="TeXLocal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TeXLocal">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="Bar"
            Height="48"
            Title="TeXLocal"
            BackRequested="OnBackRequested"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/TeXLocal.png" />
            </TitleBar.IconSource>
            <!-- The project's search, as VS Code's Command Center. A fixed width rather than Stretch: the bar lets clicks
                 through its whole content presenter, and it drops the title (compact) when the box doesn't fit. -->
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="Search"
                    Width="440"
                    x:FieldModifier="public"
                    AutomationProperties.Name="Search in project"
                    Visibility="Collapsed">
                    <AutoSuggestBox.QueryIcon>
                        <FontIcon Glyph="&#xE721;" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button
                    x:Name="SettingsButton"
                    Width="40"
                    Height="32"
                    AutomationProperties.Name="Settings"
                    Click="OnSettings"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Settings (Ctrl+,)">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <Frame x:Name="Pages" Grid.Row="1" Background="Transparent" Navigated="OnNavigated" />
    </Grid>
</Window>
