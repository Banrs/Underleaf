<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TeXLocal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TeXLocal"
    Title="TeXLocal">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- The menu chords live here, on the root, so they work on every screen
         and whichever native control has focus. -->
    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The Windows App SDK title bar: icon, title, the project as the
             subtitle, back to the library, and the sidebar toggle. -->
        <TitleBar x:Name="AppTitleBar" Title="TeXLocal" Height="48"
                  BackRequested="OnBackRequested" PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="TitleIcon" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Collapsed while closed, or its margin leaves a band under the title bar. -->
        <InfoBar x:Name="MessageBar" Grid.Row="1" Margin="16,0,16,8" Severity="Error" IsOpen="False"
                 Visibility="{x:Bind MessageBar.IsOpen, Mode=OneWay}" />

        <Grid Grid.Row="2">
            <local:HomeView x:Name="Home" />
            <local:WorkspaceView x:Name="Workspace" Visibility="Collapsed" />
            <local:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
