<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TeXLocal.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TeXLocal">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Menus on the left, the document's commands on the right, on Mica. -->
        <Grid Padding="8,0,8,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <MenuBar x:Name="Menu" VerticalAlignment="Center" />
            <CommandBar Grid.Column="1" HorizontalAlignment="Right" DefaultLabelPosition="Right"
                        Background="Transparent" VerticalContentAlignment="Center">
                <!-- A switched-on toggle gets the subtle fill File Explorer's
                     toolbar uses, not a block of accent colour. Contrast
                     themes keep the system's own colours. -->
                <CommandBar.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <StaticResource x:Key="AppBarToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="AppBarToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ControlFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ControlFillColorTransparentBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="AppBarToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="AppBarToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ControlFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ControlFillColorTransparentBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </CommandBar.Resources>
                <AppBarButton Label="Insert" Icon="Add" AccessKey="I" ToolTipService.ToolTip="Insert an environment">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="InsertMenu" Placement="BottomEdgeAlignedLeft" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Label="Bold" LabelPosition="Collapsed" Width="40" Click="OnBold" ToolTipService.ToolTip="Bold (Ctrl+B)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8DD;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Italic" LabelPosition="Collapsed" Width="40" Click="OnItalic" ToolTipService.ToolTip="Italic (Ctrl+I)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8DB;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Inline math" LabelPosition="Collapsed" Width="40" Click="OnMath" ToolTipService.ToolTip="Inline math (Ctrl+Shift+M)">
                    <AppBarButton.Icon>
                        <PathIcon Data="M1,3 H15 V5 H11.5 V12 C11.5,12.8 11.9,13.2 12.6,13.2 H14 V15 H12.2 C10.6,15 9.5,14 9.5,12.4 V5 H6.5 V15 H4.5 V5 H1 Z" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <!-- Compile is the primary action; the engine and auto-compile
                     live in its menu, the way a split button carries a default
                     and its options. -->
                <AppBarElementContainer VerticalAlignment="Center" Margin="4,0">
                    <SplitButton x:Name="CompileButton" Click="OnCompile" AccessKey="R"
                                 AutomationProperties.Name="Compile" ToolTipService.ToolTip="Compile (Ctrl+Enter)">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CompileIcon" Glyph="&#xE768;" FontSize="16" />
                            <ProgressRing x:Name="CompileProgress" Width="16" Height="16" IsActive="False"
                                          AutomationProperties.Name="Compiling" />
                            <TextBlock Grid.Column="1" Text="Compile" />
                        </Grid>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem x:Name="EnginePdf" Text="pdfLaTeX" GroupName="Engine" Tag="pdflatex" Click="OnEngine" />
                                <RadioMenuFlyoutItem x:Name="EngineXe" Text="XeLaTeX" GroupName="Engine" Tag="xelatex" Click="OnEngine" />
                                <RadioMenuFlyoutItem x:Name="EngineLua" Text="LuaLaTeX" GroupName="Engine" Tag="lualatex" Click="OnEngine" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Name="AutoCompileItem" Text="Compile automatically" Click="OnAutoCompile" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                </AppBarElementContainer>
                <AppBarElementContainer VerticalAlignment="Center" Margin="4,0">
                    <ToggleButton x:Name="LogButton" Click="OnToggleLogs" AccessKey="L" AutomationProperties.Name="Compile log"
                                  Background="Transparent" BorderThickness="0" Width="40" Height="40" Padding="0">
                        <Grid>
                            <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                            <InfoBadge x:Name="ErrorBadge" Style="{StaticResource CriticalValueInfoBadgeStyle}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-16,0"
                                       Visibility="Collapsed" />
                        </Grid>
                    </ToggleButton>
                </AppBarElementContainer>
                <AppBarToggleButton x:Name="PdfToggle" Label="PDF" LabelPosition="Collapsed" Width="40" AccessKey="P" Click="OnTogglePdf"
                                    ToolTipService.ToolTip="Show or hide the PDF (Ctrl+Shift+\)">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE90D;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton Label="Export" Icon="Share" AccessKey="X" ToolTipService.ToolTip="Save the PDF or the project elsewhere">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="SavePdfItem" Text="Save PDF as…" Click="OnSavePdf" KeyboardAcceleratorTextOverride="Ctrl+Shift+S">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEA90;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Export project as ZIP…" Click="OnExportZip">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF012;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Settings" Icon="Setting" Click="OnSettings" KeyboardAcceleratorTextOverride="Ctrl+," />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <Grid x:Name="Panes" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Files, project search and the outline, on Mica. Files dropped
                 here are added to the project, or to the folder under them. -->
            <Grid x:Name="Sidebar" Padding="8,0,0,0" RowSpacing="8" Background="Transparent" AllowDrop="True"
                  DragOver="OnDragOver" Drop="OnDrop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search project" QueryIcon="Find" AccessKey="S"
                                AutomationProperties.Name="Search project"
                                TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown" />

                <!-- As the browser version's sidebar: the files, then the
                     outline under a disclosure that remembers its state. -->
                <Grid x:Name="Browse" Grid.Row="1" RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid MinHeight="32">
                        <TextBlock Text="Files" Margin="12,0" VerticalAlignment="Center"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource SubtleButtonStyle}" Width="32" Height="28" Padding="0" Click="OnNewFile"
                                    AutomationProperties.Name="New file" ToolTipService.ToolTip="New file (Ctrl+N)">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}" Width="32" Height="28" Padding="0" Click="OnNewFolder"
                                    AutomationProperties.Name="New folder" ToolTipService.ToolTip="New folder (Ctrl+Alt+Shift+N)">
                                <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}" Width="32" Height="28" Padding="0" Click="OnAddFiles"
                                    AutomationProperties.Name="Add files" ToolTipService.ToolTip="Add files">
                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TreeView x:Name="Files" Grid.Row="1" SelectionMode="Single" CanDragItems="False"
                              CanReorderItems="False" ItemInvoked="OnFileInvoked" AutomationProperties.Name="Files"
                              ContextRequested="OnFileContextRequested" KeyDown="OnFilesKeyDown">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="local:FileItem">
                                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                              AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                        <TextBlock Text="{x:Bind Name}" />
                                        <FontIcon Glyph="&#xE735;" FontSize="12" Visibility="{x:Bind MainVisibility}"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  ToolTipService.ToolTip="Main file" />
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <Button x:Name="OutlineToggle" Grid.Row="2" Style="{StaticResource SubtleButtonStyle}" MinHeight="32"
                            Padding="12,0,8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Click="OnToggleOutline" AutomationProperties.Name="Outline">
                        <Grid>
                            <TextBlock Text="Outline" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <FontIcon x:Name="OutlineChevron" Glyph="&#xE70D;" FontSize="12" HorizontalAlignment="Right"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Button>
                    <!-- Rows start where the file rows' icons do: TreeView keeps
                         an expander column even for files, as File Explorer does. -->
                    <ListView x:Name="OutlineList" Grid.Row="3" MaxHeight="280" SelectionMode="None" IsItemClickEnabled="True"
                              AutomationProperties.Name="Outline" ItemClick="OnOutlineClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="Padding" Value="44,0,12,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:OutlineRow">
                                <TextBlock Text="{x:Bind Title}" Margin="{x:Bind Indent}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <ListView x:Name="Results" Grid.Row="1" Visibility="Collapsed" SelectionMode="None"
                          AutomationProperties.Name="Search results" IsItemClickEnabled="True" ItemClick="OnResultClick">
                    <ListView.Header>
                        <TextBlock x:Name="ResultsHeader" Margin="12,0,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SearchHit">
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{x:Bind Location}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind Before}" /><Run Text="{x:Bind Match}" FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><Run Text="{x:Bind After}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- The browser version's sidebar footer: settings, and the
                     engine that compiles, busy while it does. -->
                <Grid Grid.Row="2" Padding="0,0,4,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SubtleButtonStyle}" Width="36" Height="32" Padding="0" Click="OnSettings"
                            AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings (Ctrl+,)">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                    <Button x:Name="EngineStatus" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Height="32"
                            Padding="8,0" HorizontalAlignment="Left" Click="OnSettings">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="EngineWarning" Glyph="&#xE7BA;" FontSize="14" Visibility="Collapsed"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <ProgressRing x:Name="EngineProgress" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="EngineText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- The document on a layer above Mica, rounded where it meets the
                 window's chrome, with a status bar beneath. -->
            <Grid x:Name="Layer" Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0"
                  CornerRadius="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="Document">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- The editor's WebView2 goes in first, beneath the placeholder. -->
                    <Grid x:Name="EditorHost">
                        <Grid x:Name="EditorPlaceholder" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                            <TextBlock Text="Select a file to edit" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Grid>

                    <Grid x:Name="Preview" Grid.Column="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="1,0,0,0">
                        <local:PdfPane x:Name="Pdf" x:FieldModifier="internal" />
                        <local:LogsView x:Name="Logs" Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- The status bar, as Windows editors keep one: where the
                     cursor is, the save state, and the counts. -->
                <Grid Grid.Row="1" Padding="12,4" ColumnSpacing="24" MinHeight="32"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CrumbsText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               AutomationProperties.Name="Location in document" />
                    <TextBlock x:Name="CountsText" Grid.Column="1" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
