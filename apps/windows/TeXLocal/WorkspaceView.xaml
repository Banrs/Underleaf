<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TeXLocal.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TeXLocal">
    <Grid>

        <!-- The sidebar and the details pane are inline SplitView panes, so
             they slide open and closed as WinUI's own do, the content moving
             with them; their dividers set the panes' lengths. -->
        <SplitView x:Name="Panes" DisplayMode="Inline" PanePlacement="Left" IsPaneOpen="True"
                   OpenPaneLength="280" PaneBackground="Transparent">
            <SplitView.Pane>
            <!-- A writer's sidebar, on the base layer as NavigationView's pane
                 is: the files, the open document's outline beneath them (as
                 Overleaf pairs them) or, while the title bar's search box has
                 a query, its results. Adding files is the Files heading's
                 action, as a section header carries its commands in File
                 Explorer and Visual Studio. 8 above, so the first heading
                 sits level with the toolbar's buttons. Files dropped here
                 are added to the project, or to the folder under them. -->
            <Grid Padding="0,8,0,0" Background="Transparent" AllowDrop="True"
                  DragOver="OnDragOver" Drop="OnDrop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The files over the open document's outline, with a
                     divider between them; the outline folds to its heading,
                     docked at the sidebar's foot, and the files take the room. -->
                <Grid x:Name="Browse" Grid.Row="1" SizeChanged="OnBrowseSizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="OutlineRow" Height="0" />
                    </Grid.RowDefinitions>
                    <!-- Body Strong for a section header, 16 from the pane's
                         edge; its one action at the other end, 8 in as the
                         toolbars' buttons are. -->
                    <TextBlock Text="Files" Margin="16,0" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="0,0,8,0" HorizontalAlignment="Right"
                            AccessKey="A" AutomationProperties.Name="Add" ToolTipService.ToolTip="Add files and folders">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="New file…" Click="OnNewFile" KeyboardAcceleratorTextOverride="Ctrl+N">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="New folder…" Click="OnNewFolder" KeyboardAcceleratorTextOverride="Ctrl+Alt+Shift+N">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8F4;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Add files…" Click="OnAddFiles">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE898;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Add folder…" Click="OnAddFolder">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <TreeView x:Name="Files" Grid.Row="1" SelectionMode="Single" CanDragItems="False"
                              CanReorderItems="False" ItemInvoked="OnFileInvoked" AutomationProperties.Name="Files"
                              ContextRequested="OnFileContextRequested" KeyDown="OnFilesKeyDown">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="local:FileItem">
                                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                              AutomationProperties.Name="{x:Bind AccessibleName}"
                                              HorizontalContentAlignment="Stretch" Loaded="OnTreeItemLoaded">
                                    <!-- The main file in bold, as Visual Studio shows its
                                         startup project. -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" ToolTipService.ToolTip="{x:Bind ToolTip}">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                        <TextBlock Text="{x:Bind Name}" FontWeight="{x:Bind Weight}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <!-- A section heading as the Files one is, its line the
                         divider above it; its one action, the disclosure,
                         at the other end. The divider's grip overhangs it. -->
                    <Grid x:Name="OutlineHeader" Grid.Row="3" Height="32"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <TextBlock Text="File outline" Margin="16,0" VerticalAlignment="Center"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AccessibilityView="Raw" />
                        <Button x:Name="OutlineToggle" Style="{StaticResource ToolbarIconButtonStyle}" Margin="0,0,8,0"
                                HorizontalAlignment="Right" Click="OnToggleOutline" AutomationProperties.Name="File outline">
                            <FontIcon x:Name="OutlineChevron" Glyph="&#xE70D;" FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </Grid>
                    <!-- The headings as they nest, with the tree's own
                         expanders, as the files above: a table of contents
                         with no selection, following the top of the source. -->
                    <Grid x:Name="OutlinePane" Grid.Row="4">
                        <TreeView x:Name="OutlineTree" SelectionMode="None" CanDragItems="False" CanReorderItems="False"
                                  AutomationProperties.Name="File outline" ItemInvoked="OnOutlineInvoked"
                                  Expanding="OnOutlineExpanding" Collapsed="OnOutlineCollapsed">
                            <TreeView.ItemTemplate>
                                <DataTemplate x:DataType="local:OutlineEntry">
                                    <TreeViewItem ItemsSource="{x:Bind Children}" Loaded="OnTreeItemLoaded"
                                                  IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Title}"
                                                  AutomationProperties.ItemStatus="{x:Bind Status, Mode=OneWay}">
                                        <Grid>
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{x:Bind TitledVisibility, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{x:Bind UntitledVisibility, Mode=OneWay}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                                       Visibility="{x:Bind CurrentVisibility, Mode=OneWay}"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </TreeViewItem>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <TextBlock x:Name="NoSections" Text="No sections" Margin="16,8" Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>

                <!-- The matches, grouped under their files as macOS lists them. -->
                <ListView x:Name="Results" Grid.Row="1" Visibility="Collapsed" SelectionMode="None"
                          AutomationProperties.Name="Search results" IsItemClickEnabled="True" ItemClick="OnResultClick">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="local:SearchGroup">
                                    <TextBlock Text="{x:Bind Header}" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SearchHit">
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{x:Bind LineLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind Before}" /><Run Text="{x:Bind Match}" FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><Run Text="{x:Bind After}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="NoResults" Grid.Row="1" Visibility="Collapsed" Spacing="8" Padding="16,0"
                            VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
                    <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="No results" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="NoResultsText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

            </Grid>
            </SplitView.Pane>

            <Grid x:Name="SidebarContent">
            <!-- The content layer, as NavigationView's content area: one
                 surface, its top and leading edges stroked and the corner
                 where they meet rounded. Inside it: the source and the PDF
                 over the build panel, then the inspector, divided by the
                 splitters' 1 px lines. -->
            <Grid x:Name="Layer" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0"
                  CornerRadius="8,0,0,0">
                <SplitView x:Name="Details" DisplayMode="Inline" PanePlacement="Right" IsPaneOpen="False"
                           OpenPaneLength="260" PaneBackground="Transparent">
                    <SplitView.Pane>
                        <local:InspectorView x:Name="Inspector" />
                    </SplitView.Pane>
                <Grid x:Name="DetailsContent">
                <Grid x:Name="Editors">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="PanelRow" Height="220" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="Document">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SourceColumn" Width="*" MinWidth="240" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="240" />
                        </Grid.ColumnDefinitions>

                        <!-- The source: a writer's tools over it, then where the
                             cursor is, then the editor. -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- A writer's tools: a row 48 tall, as the title bar
                                 is, of standard 32 px buttons 8 apart and 8 in
                                 from the edge.
                                 Overleaf's tools in its order: history; the
                                 section level; bold and italic; math and symbols;
                                 links, references and citations; figures and
                                 tables; lists; then the rest in "See more". As the
                                 pane narrows, groups fold into it from the end,
                                 then the section level, then redo (FoldSourceBar). -->
                            <Grid x:Name="SourceBar" Height="48" Padding="8,0" SizeChanged="OnSourceBarSizeChanged">
                                <Grid.Resources>
                                    <!-- The drop-downs subtle, as the buttons beside
                                         them are, through the keys DropDownButton
                                         reads. The other buttons here use
                                         SubtleButtonStyle, which reads its own keys,
                                         so only the drop-downs change. -->
                                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="ControlFillColorTransparentBrush" />
                                </Grid.Resources>
                                <StackPanel x:Name="SourceTools" Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Button x:Name="UndoButton" Style="{StaticResource ToolbarIconButtonStyle}" Click="OnUndo"
                                            AutomationProperties.Name="Undo" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                                        <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                                    </Button>
                                    <Button x:Name="RedoButton" Style="{StaticResource ToolbarIconButtonStyle}" Click="OnRedo"
                                            AutomationProperties.Name="Redo" ToolTipService.ToolTip="Redo (Ctrl+Shift+Z)">
                                        <FontIcon Glyph="&#xE7A6;" FontSize="16" />
                                    </Button>
                                    <!-- Each group carries the separator before it, so a
                                         group folded into "See more" takes its own. -->
                                    <StackPanel x:Name="LatexTools" Orientation="Horizontal" Spacing="8">
                                        <!-- The caret line's level, as a word processor shows
                                             a paragraph's style; as wide as its widest value,
                                             so the bar holds still as the caret moves. -->
                                        <StackPanel x:Name="LevelTools" Orientation="Horizontal" Spacing="8">
                                            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                                            <DropDownButton x:Name="LevelButton" Height="32" AutomationProperties.Name="Section level"
                                                            ToolTipService.ToolTip="Section level">
                                                <Grid>
                                                    <TextBlock x:Name="LevelLabel" Text="Normal text" />
                                                    <TextBlock Text="Subsubsection" Opacity="0" AutomationProperties.AccessibilityView="Raw" />
                                                </Grid>
                                                <DropDownButton.Flyout>
                                                    <MenuFlyout x:Name="LevelMenu" Placement="BottomEdgeAlignedLeft" Opening="OnLevelMenuOpening" />
                                                </DropDownButton.Flyout>
                                            </DropDownButton>
                                        </StackPanel>
                                        <StackPanel x:Name="FormatTools" Orientation="Horizontal" Spacing="8">
                                            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnBold"
                                                    AutomationProperties.Name="Bold" ToolTipService.ToolTip="Bold (Ctrl+B)">
                                                <FontIcon Glyph="&#xE8DD;" FontSize="16" />
                                            </Button>
                                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnItalic"
                                                    AutomationProperties.Name="Italic" ToolTipService.ToolTip="Italic (Ctrl+I)">
                                                <FontIcon Glyph="&#xE8DB;" FontSize="16" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel x:Name="MathTools" Orientation="Horizontal" Spacing="8">
                                            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnMath"
                                                    AutomationProperties.Name="Inline math" ToolTipService.ToolTip="Inline math (Ctrl+Shift+M)">
                                                <FontIcon Glyph="&#xE94B;" FontSize="16" />
                                            </Button>
                                            <!-- Segoe Fluent Icons has no sigma or pi: Σ from the
                                                 UI font, and π drawn (PiIconData). -->
                                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnDisplayMath"
                                                    AutomationProperties.Name="Display math" ToolTipService.ToolTip="Display math">
                                                <FontIcon Glyph="Σ" FontFamily="Segoe UI" FontSize="16" />
                                            </Button>
                                            <Button Style="{StaticResource ToolbarIconButtonStyle}"
                                                    AutomationProperties.Name="Symbols" ToolTipService.ToolTip="Symbols">
                                                <PathIcon x:Name="PiIcon" />
                                                <Button.Flyout>
                                                    <!-- A grid per kind, each symbol named by its
                                                         command: one tab stop, the arrow keys
                                                         moving through it. -->
                                                    <Flyout x:Name="SymbolsFlyout" Placement="BottomEdgeAlignedLeft">
                                                        <GridView x:Name="SymbolGrid" SelectionMode="None" IsItemClickEnabled="True"
                                                                  ItemClick="OnSymbolClick" AutomationProperties.Name="Symbols">
                                                            <GridView.GroupStyle>
                                                                <GroupStyle>
                                                                    <GroupStyle.HeaderTemplate>
                                                                        <DataTemplate x:DataType="local:PaletteGroup">
                                                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                        </DataTemplate>
                                                                    </GroupStyle.HeaderTemplate>
                                                                </GroupStyle>
                                                            </GridView.GroupStyle>
                                                            <GridView.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="10" />
                                                                </ItemsPanelTemplate>
                                                            </GridView.ItemsPanel>
                                                            <GridView.ItemContainerStyle>
                                                                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                                                    <Setter Property="Width" Value="36" />
                                                                    <Setter Property="Height" Value="36" />
                                                                    <Setter Property="MinWidth" Value="36" />
                                                                    <Setter Property="MinHeight" Value="36" />
                                                                    <Setter Property="Margin" Value="0" />
                                                                    <Setter Property="Padding" Value="0" />
                                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                                </Style>
                                                            </GridView.ItemContainerStyle>
                                                            <GridView.ItemTemplate>
                                                                <DataTemplate x:DataType="local:PaletteSymbol">
                                                                    <TextBlock Text="{x:Bind Glyph}" FontSize="20" ToolTipService.ToolTip="{x:Bind Command}" />
                                                                </DataTemplate>
                                                            </GridView.ItemTemplate>
                                                        </GridView>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel x:Name="ReferenceTools" Orientation="Horizontal" Spacing="8">
                                            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnInline" Tag="Link"
                                                    AutomationProperties.Name="Link" ToolTipService.ToolTip="Link (\href)">
                                                <FontIcon Glyph="&#xE71B;" FontSize="16" />
                                            </Button>
                                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnInline" Tag="Reference"
                                                    AutomationProperties.Name="Reference" ToolTipService.ToolTip="Reference (\ref)">
                                                <FontIcon Glyph="#" FontFamily="Segoe UI" FontSize="16" />
                                            </Button>
                                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnInline" Tag="Citation"
                                                    AutomationProperties.Name="Citation" ToolTipService.ToolTip="Citation (\cite)">
                                                <FontIcon Glyph="&#xE9B1;" FontSize="16" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel x:Name="FigureTools" Orientation="Horizontal" Spacing="8">
                                            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnInsert" Tag="Figure"
                                                    AutomationProperties.Name="Figure" ToolTipService.ToolTip="Figure">
                                                <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                                            </Button>
                                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnInsert" Tag="Table"
                                                    AutomationProperties.Name="Table" ToolTipService.ToolTip="Table">
                                                <FontIcon Glyph="&#xE80A;" FontSize="16" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel x:Name="ListTools" Orientation="Horizontal" Spacing="8">
                                            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnInsert" Tag="Bulleted list"
                                                    AutomationProperties.Name="Bulleted list" ToolTipService.ToolTip="Bulleted list">
                                                <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                                            </Button>
                                            <!-- None in Segoe Fluent Icons either (NumberedListIconData). -->
                                            <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnInsert" Tag="Numbered list"
                                                    AutomationProperties.Name="Numbered list" ToolTipService.ToolTip="Numbered list">
                                                <PathIcon x:Name="NumberedListIcon" />
                                            </Button>
                                        </StackPanel>
                                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                                        <!-- What has folded, then what has no button. -->
                                        <Button Style="{StaticResource ToolbarIconButtonStyle}"
                                                AutomationProperties.Name="See more" ToolTipService.ToolTip="See more">
                                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                                            <Button.Flyout>
                                                <MenuFlyout x:Name="SourceMoreMenu" Placement="BottomEdgeAlignedLeft" Opening="OnSourceMoreOpening" />
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- The jump bar: where the cursor is, as File
                                 Explorer's address bar shows a path — the
                                 project, its folders, the file and the section.
                                 Each crumb opens a menu of its neighbours;
                                 narrow panes fold the first into "…". -->
                            <Grid Grid.Row="1" Padding="12,0"
                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <BreadcrumbBar x:Name="Crumbs" VerticalAlignment="Center" ItemClicked="OnCrumbClicked"
                                               AutomationProperties.Name="Location in document">
                                    <BreadcrumbBar.ItemTemplate>
                                        <DataTemplate x:DataType="local:Crumb">
                                            <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{x:Bind Label}">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                                <TextBlock Text="{x:Bind Label}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </BreadcrumbBar.ItemTemplate>
                                </BreadcrumbBar>
                            </Grid>

                            <!-- The editor's WebView2 goes in first, beneath the placeholder. -->
                            <Grid x:Name="EditorHost" Grid.Row="2">
                                <StackPanel x:Name="EditorPlaceholder" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="No file open" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="Choose a file in the sidebar." HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <local:PdfPane x:Name="Pdf" x:FieldModifier="internal" Grid.Column="2" />
                    </Grid>

                    <local:LogsView x:Name="Logs" Grid.Row="2" />

                <!-- The status bar, under the document and its panel only, as the
                     macOS app keeps it: the sidebar and the details pane run the
                     window's full height. How the build went (choose it for the
                     panel's issues) and the save state; where the cursor is, the
                     counts and the engine; the panel's toggle at the end. -->
                <Grid x:Name="StatusBar" Grid.Row="3" Height="32" Padding="12,0" SizeChanged="OnStatusBarSizeChanged"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="StatusStart" Orientation="Horizontal" Spacing="12">
                        <Button x:Name="BuildStatus" Style="{StaticResource SubtleButtonStyle}" Padding="8,0" Height="32"
                                Click="OnShowIssues" ToolTipService.ToolTip="Show issues">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:Name="BuildProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                                <FontIcon x:Name="BuildSucceeded" Glyph="&#xEC61;" FontSize="16" Visibility="Collapsed"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <FontIcon x:Name="BuildFailed" Glyph="&#xEB90;" FontSize="16" Visibility="Collapsed"
                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock x:Name="BuildText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                <StackPanel x:Name="ErrorCount" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                    <FontIcon Glyph="&#xEB90;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock x:Name="ErrorCountText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="WarningCount" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock x:Name="WarningCountText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel x:Name="StatusEnd" Grid.Column="2" Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="LineText" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="CountsText" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="EngineStatus" Style="{StaticResource SubtleButtonStyle}" Padding="8,0" Height="32"
                                Click="OnEngineStatus">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="EngineWarning" Glyph="&#xE7BA;" FontSize="16" Visibility="Collapsed"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock x:Name="EngineText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="PanelToggle" Width="40" Height="32" Padding="0"
                                      Click="OnTogglePanel" AutomationProperties.Name="Panel">
                            <FontIcon Glyph="&#xE90E;" FontSize="16" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>
                </Grid>
                </Grid>
                </SplitView>
            </Grid>
            </Grid>
        </SplitView>
    </Grid>
</UserControl>
