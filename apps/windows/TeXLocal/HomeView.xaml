<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TeXLocal.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TeXLocal">
    <!-- The library as Windows 11's own lists are laid out (Settings › Apps):
         a page header with its actions, then one card per project, on Mica. -->
    <Grid MaxWidth="1000" Padding="36,20,36,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Projects" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnNewProject" AccessKey="N"
                    ToolTipService.ToolTip="New project (Ctrl+Shift+N)" AutomationProperties.Name="New project">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="New project" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Height="32" Click="OnSettings" AccessKey="S" ToolTipService.ToolTip="Settings (Ctrl+,)"
                    AutomationProperties.Name="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <InfoBar x:Name="TexMissing" Grid.Row="1" Severity="Warning" IsClosable="False" IsOpen="False"
                 Title="TeX isn’t installed"
                 Message="You can write now, but compiling needs MiKTeX or TeX Live. TeXLocal notices when it’s installed.">
            <InfoBar.ActionButton>
                <HyperlinkButton Content="Get MiKTeX" NavigateUri="https://miktex.org/download" />
            </InfoBar.ActionButton>
        </InfoBar>

        <ListView x:Name="Projects" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" Padding="0,0,0,24"
                  AutomationProperties.Name="Projects" KeyDown="OnProjectsKeyDown"
                  ItemClick="OnProjectClick" ContextRequested="OnProjectContextRequested">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ProjectRow">
                    <Grid ColumnSpacing="16" Padding="16,12,8,12" MinHeight="68" CornerRadius="{StaticResource OverlayCornerRadius}"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                          AutomationProperties.Name="{x:Bind AccessibleName}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Height="32" VerticalAlignment="Center"
                                Click="OnProjectMore" ToolTipService.ToolTip="More options"
                                AutomationProperties.Name="More options">
                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="NoProjects" Grid.Row="2" Spacing="8" Margin="0,0,0,80"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE8A5;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="No projects yet" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="Start one from a template: an article, a report or slides." HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Style="{StaticResource AccentButtonStyle}" Content="New project" HorizontalAlignment="Center"
                    Margin="0,8,0,0" Click="OnNewProject" />
        </StackPanel>
    </Grid>
</UserControl>
