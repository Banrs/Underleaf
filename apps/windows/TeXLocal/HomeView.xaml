<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TeXLocal.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TeXLocal">
    <!-- The start page, as Word's and Overleaf's open: new documents from
         templates across the top, each with a drawing of its first page, then
         recent projects as a list with columns — name, main file, when last
         changed — to search, sort and open. On Mica. -->
    <UserControl.Resources>
        <Style x:Key="TemplateDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <!-- A WinUI Gallery page: one scrolling column, at most 1064 wide and
         centred. The column is centred inside a full-width grid: given straight to
         the ScrollViewer, a column with a MaxWidth was placed off-centre. -->
    <ScrollViewer>
    <Grid>
    <Grid MaxWidth="1064" Margin="36,24,36,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Projects" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnNewProject" AccessKey="N"
                    ToolTipService.ToolTip="New project (Ctrl+Shift+N)" AutomationProperties.Name="New project">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                    <TextBlock Text="New project" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Width="40" Height="32" Click="OnSettings" AccessKey="S" ToolTipService.ToolTip="Settings (Ctrl+,)"
                    AutomationProperties.Name="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <InfoBar x:Name="TexMissing" Grid.Row="1" Margin="0,16,0,0" Severity="Warning" IsClosable="False" IsOpen="False"
                 Visibility="{x:Bind TexMissing.IsOpen, Mode=OneWay}"
                 Title="TeX isn’t installed"
                 Message="You can write now, but compiling needs MiKTeX or TeX Live. TeXLocal notices when it’s installed.">
            <InfoBar.ActionButton>
                <HyperlinkButton Content="Get MiKTeX" NavigateUri="https://miktex.org/download" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Subtitle for a section of the page, as the type ramp gives it. -->
        <TextBlock Grid.Row="2" Text="New" Margin="0,24,0,12" Style="{StaticResource SubtitleTextBlockStyle}" />
        <GridView x:Name="Templates" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTemplateClick"
                  AutomationProperties.Name="Templates" ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Disabled">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <!-- GridViewItem as it comes, 4 apart; each card pads itself. -->
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                </Style>
            </GridView.ItemContainerStyle>
        </GridView>

        <TextBlock Grid.Row="4" Text="Recent" Margin="0,24,0,12" Style="{StaticResource SubtitleTextBlockStyle}" />

        <Grid Grid.Row="5" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Column headers that sort, as File Explorer's details view has
                 them, each heading's text over its column's: the rows' own
                 16 and 12 insets, and every button pulled out by its padding. -->
            <Grid x:Name="Columns" Padding="16,0,12,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SortName" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" Margin="-12,0,0,0"
                        HorizontalContentAlignment="Left" Click="OnSort" Tag="name" />
                <Button x:Name="SortMain" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" Margin="-12,0,0,0"
                        HorizontalContentAlignment="Left" Click="OnSort" Tag="main" />
                <Button x:Name="SortModified" Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" Margin="-12,0,0,0"
                        HorizontalContentAlignment="Left" Click="OnSort" Tag="modified" />
            </Grid>
            <ListView x:Name="Projects" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True"
                      AutomationProperties.Name="Recent projects" KeyDown="OnProjectsKeyDown"
                      ItemClick="OnProjectClick" ContextRequested="OnProjectContextRequested">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ProjectRow">
                        <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind MainFile}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Modified}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="NoProjects" Grid.Row="1" Spacing="8" Margin="0,24,0,0"
                        HorizontalAlignment="Center" VerticalAlignment="Top">
                <FontIcon Glyph="&#xE8A5;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="NoProjectsTitle" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="NoProjectsDetail" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="360" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
