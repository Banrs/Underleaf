<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)target\release\texlocal_ffi.dll" Link="texlocal_ffi.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Every build, as cargo knows what the DLL depends on: a list kept here missed the core's catalog.json and kept a
       stale DLL. -->
  <Target Name="Cargo" BeforeTargets="BeforeBuild" Condition="'$(SkipCargo)' != 'true'">
    <Exec Command="cargo rustc -p texlocal-ffi --lib --release --crate-type cdylib" WorkingDirectory="$(RepoRoot)" />
  </Target>
</Project>
