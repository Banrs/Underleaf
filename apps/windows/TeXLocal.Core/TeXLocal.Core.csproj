<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <RustSource Include="$(RepoRoot)crates\**\*.rs;$(RepoRoot)crates\**\Cargo.toml" />
    <None Include="$(RepoRoot)target\release\texlocal_ffi.dll" Link="texlocal_ffi.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="Cargo" BeforeTargets="BeforeBuild" Condition="'$(SkipCargo)' != 'true'"
          Inputs="@(RustSource);$(RepoRoot)Cargo.toml;$(RepoRoot)Cargo.lock"
          Outputs="$(RepoRoot)target\release\texlocal_ffi.dll">
    <Exec Command="cargo rustc -p texlocal-ffi --lib --release --crate-type cdylib" WorkingDirectory="$(RepoRoot)" />
    <Touch Files="$(RepoRoot)target\release\texlocal_ffi.dll" />
  </Target>
</Project>
