+/* ---------------- for an editor showing the pages itself ---------------- */
+
+uint64_t txp_tex_page_hash(txp_engine *_self, int page)
+{
+  SELF;
+  const unsigned char *data;
+  size_t len;
+  incdvi_page_bytes(self->dvi, self->st.document.entry->saved.data, page, &data, &len);
+  uint64_t hash = 0xcbf29ce484222325ull;
+  for (size_t i = 0; i < len; i++)
+    hash = (hash ^ data[i]) * 0x100000001b3ull;
+  return hash ? hash : 1;
+}
+
+/* How a run that is over ended: TeX says goodbye either way, after a fatal error
+ * too. */
+int txp_tex_outcome(txp_engine *_self)
+{
+  SELF;
+  static const char *const fatal[] = {
+    "\n! Emergency stop", "(That makes 100 errors; please try again.)",
+    "\n! TeX capacity exceeded", "\n! This can't happen", "\n! I can't go on meeting you",
+  };
+  fz_buffer *out = output_data(self->st.stdout.entry);
+  if (!out)
+    return RUN_STOPPED;
+  for (int i = 0; i < 5; i++)
+    if (memmem(out->data, out->len, fatal[i], strlen(fatal[i])))
+      return RUN_STOPPED;
+  if (!memmem(out->data, out->len, "Output written on ", 18) &&
+      !memmem(out->data, out->len, "No pages of output.", 19))
+    return RUN_STOPPED;
+  return RUN_COMPLETE;
+}
+
+/* Files TeX writes that are outputs, not inputs to a later pass. */
+static bool is_system_output(const char *path);
+
+/* Whether a file TeX reads and writes (.aux, .toc, .out) was written other than
+ * as read: another pass would show other references or contents. */
+bool txp_tex_aux_changed(txp_engine *_self)
+{
+  SELF;
+  fileentry_t *e;
+  for (int i = 0; (e = filesystem_scan(self->fs, &i));)
+  {
+    if (e->saved.level != FILE_WRITE || !e->saved.data || !e->wanted ||
+        is_system_output(e->path))
+      continue;
+    fz_buffer *read = e->edit_data ? e->edit_data : e->fs_data;
+    size_t len = read ? read->len : 0;
+    if (len != e->saved.data->len ||
+        (len && memcmp(e->saved.data->data, read->data, len) != 0))
+      return true;
+  }
+  return false;
+}
+
+/* A finishing pass: TeX again from the start, reading what the last run wrote. */
+void txp_tex_rerun(txp_engine *_self, fz_context *ctx)
+{
+  SELF;
+  fileentry_t *e;
+  for (int i = 0; (e = filesystem_scan(self->fs, &i));)
+  {
+    if (e->saved.level != FILE_WRITE || !e->saved.data || is_system_output(e->path))
+      continue;
+    if (e->edit_data && !e->edit_data_from_convergence) continue; /* editor-owned */
+    if (e->edit_data) fz_drop_buffer(ctx, e->edit_data);
+    e->edit_data = fz_new_buffer_from_copied_data(ctx, e->saved.data->data,
+                                                  e->saved.data->len);
+    e->edit_data_from_convergence = true;
+  }
+  do_run(ctx, self);
+}
+
+/* A pass runs in place. */
+txp_engine *txp_tex_successor(txp_engine *self, fz_context *ctx)
+{
+  (void)ctx;
+  return self;
+}
+
+/* In-process, a step never waits. */
+int txp_tex_worker_fd(txp_engine *self)
+{
+  (void)self;
+  return -1;
+}
+
+/* Where the last edit or caret was: an edit there resumes a checkpoint taken
+ * just before it. */
+bool txp_tex_warm(txp_engine *_self, fileentry_t **entry, int *offset)
+{
+  SELF;
+  *entry = self->warm.entry;
+  *offset = self->warm.offset;
+  return self->warm.entry != NULL;
+}
+
+/* Checkpoints to come just before `offset` of `entry`, and a little further
+ * back, when TeX hasn't read that far: the first edit there resumes one instead
+ * of a run from the start. Whether they are set. */
+bool txp_tex_plant(txp_engine *_self, fileentry_t *entry, int offset)
+{
+  SELF;
+  static const int back[] = {2048, 512, 64};
+  fz_buffer *data = entry_data(entry);
+  if (!data || !self->running || edited_read(self, entry, offset) != INT_MAX)
+    return false;
+  self->plant.entry = entry;
+  self->plant.count = 0;
+  for (int i = 0; i < 3; i++)
+  {
+    int pos = offset - back[i];
+    if (pos > 0 && (self->plant.count == 0 || pos > self->plant.pos[self->plant.count - 1]))
+      self->plant.pos[self->plant.count++] = pos;
+  }
+  self->warm.entry = entry;
+  self->warm.offset = offset;
+  return self->plant.count > 0;
+}
+
+fz_rect txp_tex_page_box(txp_engine *_self, int page)
+{
+  SELF;
+  float pw, ph;
+  bool landscape;
+  incdvi_page_dim(self->dvi, self->st.document.entry->saved.data, page, &pw, &ph,
+                  &landscape);
+  return fz_make_rect(0, 0, pw, ph);
+}
+
+/* The page straight to a device: a display list in between is only for drawing
+ * it again. */
+void txp_tex_run_page(txp_engine *_self, fz_context *ctx, int page, fz_device *dev)
+{
+  SELF;
+  incdvi_render_page(ctx, self->dvi, self->st.document.entry->saved.data, page, dev);
+}
+
+txp_engine *txp_tex_live_engine(fz_context *ctx, const char *exe_path, const char *root,
+                                const char *name, const char *inputs)
+{
+  struct wasm_engine *self = (struct wasm_engine *)txp_create_tex_engine(
+      ctx, exe_path, name, dvi_texlive_hooks(ctx, root));
+  self->live = true;
+  self->root = fz_strdup(ctx, root);
+  if (*inputs)
+  {
+    /* The document's folder first, as TeX's own path has it, and the trailing
+     * colon keeps texmf.cnf's own path after them. */
+    char path[8192];
+    snprintf(path, sizeof path, ".:%s:", inputs);
+    env_add(&self->env, &self->nenv, "TEXINPUTS", path);
+    env_add(&self->env, &self->nenv, "BIBINPUTS", path);
+  }
+  return (txp_engine *)self;
+}
