diff --git a/src/embed/embed.c b/src/embed/embed.c
new file mode 100644
index 0000000..4c617ca
--- /dev/null
+++ b/src/embed/embed.c
@@ -0,0 +1,235 @@
+/* TeXpresso in an app's own process: see texpresso.h. Built without
+ * embed_config.h, so stderr here is the process's. */
+#include <fcntl.h>
+#include <limits.h>
+#include <mach-o/dyld.h>
+#include <poll.h>
+#include <pthread.h>
+#include <setjmp.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include "texpresso.h"
+#include "../frontend/editor.h"
+#include "../frontend/live.h"
+#include "engines.h"
+
+static __thread FILE *thread_stderr;
+
+FILE *txp_stderr(void)
+{
+  return thread_stderr ? thread_stderr : stderr;
+}
+
+/* Where an abort() on this thread goes (embed_config.h): the end of its session
+ * or run. A failed invariant, or no room for an engine's memory, isn't the
+ * app's end. */
+static __thread sigjmp_buf *ending;
+
+void txp_abort(void)
+{
+  if (ending)
+    siglongjmp(*ending, 1);
+  abort();
+}
+
+/* kpathsea lstat()s argv[0] to find itself: a real file, the app's binary. */
+static char exe[PATH_MAX];
+
+static void find_exe(void)
+{
+  char path[PATH_MAX];
+  uint32_t size = sizeof path;
+  if (_NSGetExecutablePath(path, &size) != 0 || !realpath(path, exe))
+    strcpy(exe, "/");
+}
+
+static const char *exe_path(void)
+{
+  static pthread_once_t once = PTHREAD_ONCE_INIT;
+  pthread_once(&once, find_exe);
+  return exe;
+}
+
+/* The engine on `thread` is signalled (SIGURG, wasm_host.h) every 250 ms while
+ * `commands` has something waiting, or once `*cancel` is set: TeX that computes
+ * without end gives way. Slower than that, a heavy page isn't lost to every
+ * keystroke. */
+struct watchdog
+{
+  pthread_t thread, self;
+  int commands;
+  const volatile int *cancel;
+  volatile int done;
+};
+
+static void *watch(void *data)
+{
+  struct watchdog *w = data;
+  while (!w->done)
+  {
+    struct pollfd fd = {w->commands, POLLRDNORM, 0};
+    bool due = poll(&fd, 1, 250) == 1 || (w->cancel && *w->cancel);
+    if (due && !w->done)
+    {
+      pthread_kill(w->thread, SIGURG);
+      usleep(250000);
+    }
+  }
+  return NULL;
+}
+
+static void watch_start(struct watchdog *w)
+{
+  w->thread = pthread_self();
+  pthread_create(&w->self, NULL, watch, w);
+}
+
+static void watch_end(struct watchdog *w)
+{
+  w->done = 1;
+  pthread_join(w->self, NULL);
+}
+
+struct txp_session
+{
+  pthread_t thread;
+  int argc;
+  char **argv;
+  char *pdf_output;
+  int commands, messages, log; // the session's ends of the pipes
+  int status;
+};
+
+static void *run(void *data)
+{
+  txp_session *s = data;
+  FILE *messages = fdopen(s->messages, "w");
+  thread_stderr = fdopen(s->log, "w");
+  editor_set_output(messages);
+  struct watchdog w = {.commands = s->commands};
+  watch_start(&w);
+  sigjmp_buf end;
+  ending = &end;
+  if (sigsetjmp(end, 1))
+  {
+    txp_engines[0].shutdown();
+    s->status = 134;
+  }
+  else
+    s->status = txp_live_main(s->argc, (const char *const *)s->argv, exe_path(),
+                              s->pdf_output, s->commands);
+  ending = NULL;
+  watch_end(&w);
+  fclose(messages);
+  fclose(thread_stderr);
+  thread_stderr = NULL;
+  close(s->commands);
+  return NULL;
+}
+
+static void free_session(txp_session *s)
+{
+  for (int i = 0; i < s->argc; i++) free(s->argv[i]);
+  free(s->argv);
+  free(s->pdf_output);
+  free(s);
+}
+
+txp_session *txp_live_start(int argc, const char *const *argv, const char *pdf_output,
+                            int *commands, int *messages, int *log)
+{
+  int in[2], out[2], err[2];
+  if (pipe(in) != 0) return NULL;
+  if (pipe(out) != 0) { close(in[0]); close(in[1]); return NULL; }
+  if (pipe(err) != 0)
+  {
+    close(in[0]); close(in[1]); close(out[0]); close(out[1]);
+    return NULL;
+  }
+  for (int i = 0; i < 2; i++)
+  {
+    fcntl(in[i], F_SETFD, FD_CLOEXEC);
+    fcntl(out[i], F_SETFD, FD_CLOEXEC);
+    fcntl(err[i], F_SETFD, FD_CLOEXEC);
+  }
+  txp_session *s = calloc(1, sizeof *s);
+  s->argc = argc;
+  s->argv = calloc(argc + 1, sizeof *s->argv);
+  for (int i = 0; i < argc; i++) s->argv[i] = strdup(argv[i]);
+  s->pdf_output = strdup(pdf_output);
+  s->commands = in[0];
+  s->messages = out[1];
+  s->log = err[1];
+
+  // The engine has its own stack; MuPDF, writing pages, wants more than a
+  // secondary thread's default.
+  pthread_attr_t attr;
+  pthread_attr_init(&attr);
+  pthread_attr_setstacksize(&attr, 8u << 20);
+  int failed = pthread_create(&s->thread, &attr, run, s);
+  pthread_attr_destroy(&attr);
+  if (failed)
+  {
+    for (int i = 0; i < 2; i++) close(in[i]), close(out[i]), close(err[i]);
+    free_session(s);
+    return NULL;
+  }
+  *commands = in[1];
+  *messages = out[0];
+  *log = err[0];
+  return s;
+}
+
+int txp_session_wait(txp_session *s)
+{
+  pthread_join(s->thread, NULL);
+  int status = s->status;
+  free_session(s);
+  return status;
+}
+
+int txp_run(const char *engine, int argc, const char *const *argv, const char *cwd,
+            int output, const char *const *env, const volatile int *cancel)
+{
+  for (const struct txp_engine_entry *e = txp_engines; e->name; e++)
+  {
+    if (strcmp(e->name, engine) != 0)
+      continue;
+    // The engine is the app's binary to kpathsea, which looks for itself; a TeX
+    // engine keeps the name it was called by (pdflatex: its format) as -progname.
+    bool tex = !strcmp(engine, "pdftex") || !strcmp(engine, "xetex") || !strcmp(engine, "luatex");
+    char progname[256];
+    snprintf(progname, sizeof progname, "-progname=%s", argv[0]);
+    const char **args = calloc(argc + 2, sizeof *args);
+    int n = 0;
+    args[n++] = exe_path();
+    if (tex) args[n++] = progname;
+    for (int i = 1; i < argc; i++) args[n++] = argv[i];
+    int fd = dup(output);
+    FILE *previous = thread_stderr;
+    thread_stderr = fd >= 0 ? fdopen(fd, "w") : NULL;
+    struct watchdog w = {.commands = -1, .cancel = cancel};
+    watch_start(&w);
+    sigjmp_buf end, *outer = ending;
+    ending = &end;
+    int status;
+    if (sigsetjmp(end, 1))
+    {
+      e->shutdown();
+      status = 134;
+    }
+    else
+      status = e->run(n, (char **)args, cwd, output, (char *const *)env, cancel);
+    ending = outer;
+    watch_end(&w);
+    free(args);
+    if (thread_stderr) fclose(thread_stderr);
+    thread_stderr = previous;
+    return status;
+  }
+  return -1;
+}
diff --git a/src/embed/embed_config.h b/src/embed/embed_config.h
new file mode 100644
index 0000000..cbfa13e
--- /dev/null
+++ b/src/embed/embed_config.h
@@ -0,0 +1,27 @@
+/* Included before every source of the embedded build (cc -include), the wasm
+ * runtime's too: TeXpresso runs on a thread of an app, so its diagnostics go to
+ * that session's log rather than the app's stderr, an abort() ends that thread's
+ * session or run rather than the app (embed.c), and on iOS there are no
+ * processes to start (kpsewhich, tectonic): the TeX tree is found from
+ * TEXPRESSO_LSR instead. */
+#ifndef TXP_EMBED_CONFIG_H
+#define TXP_EMBED_CONFIG_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <TargetConditionals.h>
+
+FILE *txp_stderr(void);
+#undef stderr
+#define stderr txp_stderr()
+
+__attribute__((noreturn)) void txp_abort(void);
+#define abort() txp_abort()
+
+#if TARGET_OS_IPHONE
+#define popen(command, mode) ((void)(command), (void)(mode), (FILE *)NULL)
+#define pclose(file) ((void)(file), -1)
+#define system(command) ((void)(command), -1)
+#endif
+
+#endif
