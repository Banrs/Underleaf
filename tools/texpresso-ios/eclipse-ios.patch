+void txp_tex_set_paths(txp_engine *_self, fz_context *ctx, const char *root,
+                       const char *inputs)
+{
+  SELF;
+  fz_free(ctx, self->root);
+  self->root = root ? fz_strdup(ctx, root) : NULL;
+  if (inputs && *inputs)
+  {
+    /* The document's folder first, as TeX's own path has it, and the trailing
+     * colon keeps texmf.cnf's own path after them. */
+    char path[8192];
+    snprintf(path, sizeof path, ".:%s:", inputs);
+    env_add(&self->env, &self->nenv, "TEXINPUTS", path);
+    env_add(&self->env, &self->nenv, "BIBINPUTS", path);
+  }
+}
