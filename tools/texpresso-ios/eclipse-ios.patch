index 0000000..80b32f2
--- /dev/null
+++ b/src/embed/texpresso.h
@@ -0,0 +1,55 @@
+/* TeXpresso in an app's own process, for systems that start no processes
+ * (iPadOS): Live Preview on a thread speaking TeXpresso's line protocol over
+ * pipes, and one-off engine runs (Compile) on the caller's thread.
+ *
+ * Before either, the app sets the TeX tree's variables in its environment, once
+ * at launch (they are read, not written, from then on): TEXMFCNF (the folder of
+ * texmf.cnf), TEXMFROOT, TEXMFDIST, TEXMFVAR (writable, for ls-R and fonts),
+ * TEXPRESSO_LSR (the tree's ls-R files, colon-separated), TEXPRESSO_CACHE
+ * (writable: generated formats) and ICU_DATA (the folder of XeTeX's icudt*.dat).
+ */
+#ifndef TEXPRESSO_H
+#define TEXPRESSO_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct txp_session txp_session;
+
+/* Starts Live Preview, as `texpresso` with TEXPRESSO_PDF_OUTPUT=`pdf_output`
+ * would: `argv` as its command line's (argv[0] is ignored), e.g. -json -I
+ * <build folder> <main.tex>, with relative paths against the app's working
+ * directory. On return, `*commands` takes its input, `*messages` gives its
+ * protocol lines and `*log` its diagnostics (the program's stderr). Closing
+ * `*commands` ends it, as the program ends when its stdin closes; then
+ * `*messages` and `*log` reach their end. NULL if it couldn't start. One session
+ * runs at a time: start the next once txp_session_wait has returned.
+ *
+ * TeX that computes on without reading or writing (a \loop that never ends) is
+ * stopped once commands have waited a quarter of a second for it, and taken up
+ * again from its last checkpoint after them: typing still reaches it. */
+txp_session *txp_live_start(int argc, const char *const *argv, const char *pdf_output,
+                            int *commands, int *messages, int *log);
+
+/* Waits for the session to end, frees it, and gives its exit status: 134 when
+ * the engine or TeXpresso aborted, which ends the session, not the app. */
+int txp_session_wait(txp_session *session);
+
+/* Runs `engine` ("pdftex", "xetex", "bibtex", ...) once, to the end, on the
+ * calling thread, as the program would run in `cwd`: argv as its command line's,
+ * argv[0] the name it is called by ("pdflatex" runs pdftex with pdflatex.fmt),
+ * reading and writing the files there, its
+ * terminal output to `output` (a file descriptor). `env` is NULL or NAME=value
+ * strings (NULL-terminated) seen before the process environment. A nonzero
+ * `*cancel` ends the run in about a quarter of a second, computing or not, with
+ * status 130. Returns the exit status, 134 if the engine aborted, or -1 if there
+ * is no such engine. */
+int txp_run(const char *engine, int argc, const char *const *argv, const char *cwd,
+            int output, const char *const *env, const volatile int *cancel);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
