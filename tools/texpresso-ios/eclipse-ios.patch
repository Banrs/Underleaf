+/* One message for the editor's own PDF view: `sexp` or `json` up to the path, then the path,
+   then what follows it. */
+static void live_message(const char *sexp, const char *json, const char *path,
+                         const char *sexp_rest, const char *json_rest)
+{
+  bool s = protocol == EDITOR_SEXP;
+  fputs(s ? sexp : json, editor_out);
+  if (path)
+  {
+    putc_unlocked('"', editor_out);
+    if (s) output_sexp_string(editor_out, path, strlen(path));
+    else output_json_string(editor_out, path, strlen(path));
+    putc_unlocked('"', editor_out);
+  }
+  fputs(s ? sexp_rest : json_rest, editor_out);
+  fflush(editor_out);
+}
+
+void editor_live(int version)
+{
+  char sexp[64], json[64];
+  snprintf(sexp, sizeof sexp, "(live %d)\n", version);
+  snprintf(json, sizeof json, "[\"live\", %d]\n", version);
+  live_message(sexp, json, NULL, "", "");
+}
+
+void editor_page(int page, const char *path, int mark)
+{
+  char sexp[64], json[64], sexp_rest[64], json_rest[64];
+  snprintf(sexp, sizeof sexp, "(page %d ", page);
+  snprintf(json, sizeof json, "[\"page\", %d, ", page);
+  snprintf(sexp_rest, sizeof sexp_rest, " %d)\n", mark);
+  snprintf(json_rest, sizeof json_rest, ", %d]\n", mark);
+  live_message(sexp, json, path, sexp_rest, json_rest);
+}
+
+static const char *run_name(enum EDITOR_RUN run)
+{
+  return run == RUN_COMPLETE ? "complete" : run == RUN_STOPPED ? "stopped" : "partial";
+}
+
+/* The whole document written to `path`; `changed` holds `ranges` pairs of first and last
+   page that differ from the document written before. */
+void editor_pdf(const char *path, int pages, enum EDITOR_RUN run, const int *changed, int ranges, int mark)
+{
+  bool s = protocol == EDITOR_SEXP;
+  fputs(s ? "(pdf " : "[\"pdf\", ", editor_out);
+  putc_unlocked('"', editor_out);
+  if (s) output_sexp_string(editor_out, path, strlen(path));
+  else output_json_string(editor_out, path, strlen(path));
+  fprintf(editor_out, s ? "\" %d %s (" : "\", %d, \"%s\", [", pages, run_name(run));
+  for (int i = 0; i < ranges; i++)
+    fprintf(editor_out, s ? "%s(%d %d)" : "%s[%d, %d]", i ? (s ? " " : ", ") : "",
+            changed[2 * i], changed[2 * i + 1]);
+  fprintf(editor_out, s ? ") %d)\n" : "], %d]\n", mark);
+  fflush(editor_out);
+}
