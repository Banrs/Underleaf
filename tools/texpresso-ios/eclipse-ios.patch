diff --git a/scripts/build-wasm-tools.sh b/scripts/build-wasm-tools.sh
new file mode 100755
index 0000000..d19fab8
--- /dev/null
+++ b/scripts/build-wasm-tools.sh
@@ -0,0 +1,52 @@
+#!/bin/bash
+# Cross-compile the programs a compile runs beside TeX — bibtex, makeindex and
+# xdvipdfmx (XeTeX's PDF writer) — to WebAssembly, as build-wasm-pdftex.sh does
+# pdftex, for wasm2c (scripts/build-wasm2c-tool.sh). For an app that runs them
+# in-process, where it can't start them.
+#
+# Prerequisites: scripts/fetch-engines.sh (source), and emcc on PATH.
+# Output: engines/build-wasm-tools/texk/{web2c/bibtex,makeindexk/makeindex,
+#         dvipdfm-x/xdvipdfmx}.wasm
+set -euo pipefail
+
+export EMCC_SKIP_SANITY_CHECK=1
+
+WASMFLAGS="-O2 -sSUPPORT_LONGJMP=wasm -fwasm-exceptions"
+LINKFLAGS="-sSUPPORT_LONGJMP=wasm -fwasm-exceptions -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=4MB"
+
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+SRC="$ROOT/engines/texlive-source"
+BUILD="$ROOT/engines/build-wasm-tools"
+
+[ -d "$SRC" ] || { echo "run scripts/fetch-engines.sh first" >&2; exit 1; }
+command -v emcc >/dev/null || { echo "emcc not on PATH (install emscripten)" >&2; exit 1; }
+
+BUILD_TRIPLE="$("$SRC/build-aux/config.guess")"
+rm -rf "$BUILD"; mkdir -p "$BUILD"; cd "$BUILD"
+
+emconfigure "$SRC/configure" \
+  --build="$BUILD_TRIPLE" --host=wasm32-unknown-emscripten \
+  --without-x --disable-shared --disable-all-pkgs \
+  --enable-web2c --disable-tex --disable-etex --disable-ptex --disable-eptex \
+  --disable-uptex --disable-euptex --disable-aleph --disable-pdftex --disable-xetex \
+  --disable-luatex --disable-luajittex --disable-mf --disable-mf-nowin --disable-synctex \
+  --enable-makeindexk --enable-dvipdfm-x --enable-missing \
+  CFLAGS="$WASMFLAGS" CXXFLAGS="$WASMFLAGS" LDFLAGS="$LINKFLAGS"
+
+# xdvipdfmx links zlib, libpng and libpaper, bibtex and makeindex only kpathsea: trim the
+# libraries configure would otherwise go into (luajit can't cross-build).
+sed -i.bak 's/^CONF_SUBDIRS = .*/CONF_SUBDIRS = zlib libpng libpaper/' libs/Makefile
+sed -i.bak2 's/^MAKE_SUBDIRS = .*/MAKE_SUBDIRS = zlib libpng libpaper/' libs/Makefile
+
+JOBS="$(sysctl -n hw.ncpu 2>/dev/null || nproc)"
+# The C++ libraries' Makefiles name the host's ar (see build-wasm-pdftex.sh).
+EMAR_VARS="AR=emar RANLIB=emranlib"
+# "all" goes on into web2c's luatex, which needs lua53: -k configures the rest.
+emmake make $EMAR_VARS -k -j"$JOBS" || true
+emmake make $EMAR_VARS -C texk/web2c -j"$JOBS" bibtex
+emmake make $EMAR_VARS -C texk/makeindexk -j"$JOBS" makeindex
+emmake make $EMAR_VARS -C texk/dvipdfm-x -j"$JOBS" xdvipdfmx
+
+for w in texk/web2c/bibtex texk/makeindexk/makeindex texk/dvipdfm-x/xdvipdfmx; do
+  ls -la "$w.wasm" || { echo "$w.wasm not produced" >&2; exit 1; }
+done
