diff --git a/scripts/build-wasm2c-tool.sh b/scripts/build-wasm2c-tool.sh
new file mode 100755
index 0000000..8c4887c
--- /dev/null
+++ b/scripts/build-wasm2c-tool.sh
@@ -0,0 +1,33 @@
+#!/bin/bash
+# wasm2c one of build-wasm-tools.sh's programs, and link it with the host as
+# build-wasm2c-pdftex.sh does an engine: `-n engine`, so the same host runs it.
+#
+# Usage: scripts/build-wasm2c-tool.sh bibtex|makeindex|xdvipdfmx
+# Output: engines/build-wasm2c-<tool>/engine.c, <tool>-native
+set -euo pipefail
+
+TOOL="$1"
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+case "$TOOL" in
+  bibtex) WASM="$ROOT/engines/build-wasm-tools/texk/web2c/bibtex.wasm" ;;
+  makeindex) WASM="$ROOT/engines/build-wasm-tools/texk/makeindexk/makeindex.wasm" ;;
+  xdvipdfmx) WASM="$ROOT/engines/build-wasm-tools/texk/dvipdfm-x/xdvipdfmx.wasm" ;;
+  *) echo "unknown tool: $TOOL" >&2; exit 1 ;;
+esac
+OUT="$ROOT/engines/build-wasm2c-$TOOL"
+HOST="$ROOT/src/engine-wasm/wasm_host.c"
+WABT_PREFIX="${WABT_PREFIX:-$(brew --prefix wabt)}"
+RT_SRC="$WABT_PREFIX/share/wabt/wasm2c"
+RT_INC="$WABT_PREFIX/include"
+
+[ -f "$WASM" ] || { echo "missing $WASM — run build-wasm-tools.sh first" >&2; exit 1; }
+mkdir -p "$OUT"; cd "$OUT"
+wasm2c $(wasm2c --help | grep -o -- --enable-exceptions) -n engine "$WASM" -o engine.c
+cc -O2 -I"$RT_INC" -I"$OUT" -c engine.c -o engine.o
+for f in wasm-rt-impl wasm-rt-mem-impl wasm-rt-exceptions-impl; do
+  cc -O2 -I"$RT_INC" -c "$RT_SRC/$f.c" -o "$f.o"
+done
+cc -O2 -I"$RT_INC" -I"$RT_SRC" -I"$OUT" -c "$HOST" -o wasm_host.o
+cc -O2 -o "$TOOL-native" wasm_host.o engine.o wasm-rt-impl.o wasm-rt-mem-impl.o \
+   wasm-rt-exceptions-impl.o -lm
+echo "built: $OUT/$TOOL-native"
