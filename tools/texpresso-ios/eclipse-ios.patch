+  incdvi_page_dim(self->dvi, self->st.document.entry->saved.data, page, &pw, &ph,
+                  &landscape);
+  return fz_make_rect(0, 0, pw, ph);
+}
+
+/* The page straight to a device: a display list in between is only for drawing
