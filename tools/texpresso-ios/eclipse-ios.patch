diff --git a/src/frontend/state.h b/src/frontend/state.h
index 031358d..6edd9c6 100644
--- a/src/frontend/state.h
+++ b/src/frontend/state.h
@@ -55,6 +55,8 @@ typedef struct fileentry_s {
   fz_buffer *edit_data;
   bool promised;
   bool edit_data_from_convergence;
+  // TeX has asked to read it, found or not: what it writes there is its input next time
+  bool wanted;
 
