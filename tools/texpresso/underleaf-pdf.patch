+/* Live preview in the editor's own PDF view
+ *
+ * The editor says which pages it shows (["view", first, last]). A change is typeset as far
+ * as the last of them, and each page in view whose content differs from what the editor was
+ * last given is written at once as a one-page PDF of its own (["page", index, path, mark]).
+ * The rest of the document follows once typing pauses, in slices that a change interrupts.
+ * The whole document, with its SyncTeX, is written when a run has reached the end and
+ * differs from the one written before (["pdf", path, pages, run, changed, mark]).
+ *
+ * References and contents come from finishing passes, which a second engine runs beside the
+ * first once the document has been left alone for a moment, and only when a file TeX reads
+ * back (.aux, .toc) was written other than as read. The second replaces the first when it
+ * is done; a change in between drops it, and the first resumes its snapshots as if there
+ * had been no pass. */
+
+#define LIVE_PASSES 4
+
+/* ms after a change: before the pages past the view are typeset, before the whole document
+   is written, and before a finishing pass starts. */
+static int live_tail_ms = 150, live_whole_ms = 300, live_rerun_ms = 1000;
+
+typedef struct
+{
+  uint64_t now;   // the page as typeset, by its bytes (pages below live.checked)
+  uint64_t shown; // as the editor was last given it, in a page of its own or the document
+  uint64_t whole; // as in the whole document last written
+  int file[2];    // its own PDFs, by serial: the latest, and the one before it
+} live_page;
+
+static struct
+{
+  live_page *pages;
+  int cap;
+  int checked;       // pages below this are compared since they were typeset
+  int serial;        // of the last page file
+  uint64_t salt;     // changes when a file on disk did: its pages are other pages
+  int whole_pages;   // pages in the whole document last written, -1 before the first
+  bool had_complete; // a whole document of a run that reached the end was written
+  bool whole_complete; // and the one last written is such a one
+  bool dirty;        // a page differs from the whole document last written
+  int synced;        // the last mark told as shown
+  bool started;      // the first run is over
+  double changed_at; // when a file last changed, once it is
+  enum EDITOR_RUN run; // how the last run ended
+  bool aux;          // and whether it wrote the files it reads other than as read
+  int passes;        // finishing passes since the last change
+  txp_engine *pass;  // the one under way
+  char dir[4096];
+} live;
+
+static double live_ms(void)
+{
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return t.tv_sec * 1000.0 + t.tv_nsec / 1e6;
+}
+
+static live_page *live_at(fz_context *ctx, int index)
+{
+  if (index >= live.cap)
+  {
+    int cap = live.cap ? live.cap : 64;
+    while (cap <= index) cap *= 2;
+    live.pages = fz_realloc_array(ctx, live.pages, cap, live_page);
+    memset(live.pages + live.cap, 0, (cap - live.cap) * sizeof(live_page));
+    live.cap = cap;
+  }
+  return &live.pages[index];
+}
+
+static void live_page_path(char *path, size_t size, int index, int serial)
+{
+  snprintf(path, size, "%s/page-%d-%d.pdf", live.dir, index, serial);
+}
+
+/* A page's own PDF is removed one step after another replaces it (`serial`, or 0 for the
+   whole document): the editor may be about to read the one it was just told of. */
+static void live_retire(live_page *page, int index, int serial)
+{
+  char path[4200];
+  if (page->file[1])
+  {
+    live_page_path(path, sizeof path, index, page->file[1]);
+    remove(path);
+  }
+  page->file[1] = page->file[0];
+  page->file[0] = serial;
+}
+
+static bool live_write_page(fz_context *ctx, ui_state *ui, int index)
+{
+  live_page *page = &live.pages[index];
+  int serial = ++live.serial;
+  char path[4200];
+  live_page_path(path, sizeof path, index, serial);
+  fz_document_writer *writer = NULL;
+  fz_var(writer);
+  fz_try(ctx)
+  {
+    writer = fz_new_pdf_writer(ctx, path, "");
+    fz_device *dev = fz_begin_page(ctx, writer, txp_tex_page_box(ui->eng, index));
+    txp_tex_run_page(ui->eng, ctx, index, dev);
+    fz_end_page(ctx, writer);
+    fz_close_document_writer(ctx, writer);
+  }
+  fz_always(ctx)
+    fz_drop_document_writer(ctx, writer);
+  fz_catch(ctx)
+  {
+    fprintf(stderr, "[pdf] couldn't write %s: %s\n", path, fz_caught_message(ctx));
+    remove(path);
+    return false;
+  }
+  live_retire(page, index, serial);
+  page->shown = page->now;
+  // Complete on disk before the editor hears of it.
+  editor_page(index, path, live_wish.mark);
+  return true;
+}
+
+/* Compares the pages typeset since the last look, and writes those in view that differ from
+   what the editor has; with `view`, first the earlier ones that have come into view. */
+static void live_scan(fz_context *ctx, ui_state *ui, bool view)
+{
+  int count = send(page_count, ui->eng);
+  if (live.checked > count)
+    live.checked = count;
+  // Until the editor has a document, there is nothing for a page of its own to replace.
+  bool pages = live.whole_pages >= 0;
+  if (view && pages)
+    for (int i = live_wish.first; i <= live_wish.last && i < live.checked; i++)
+      if (live.pages[i].now != live.pages[i].shown)
+        live_write_page(ctx, ui, i);
+  for (; live.checked < count; live.checked++)
+  {
+    int i = live.checked;
+    live_page *page = live_at(ctx, i);
+    page->now = txp_tex_page_hash(ui->eng, i) ^ live.salt;
+    if (page->now != page->whole)
+      live.dirty = true;
+    if (pages && i >= live_wish.first && i <= live_wish.last && page->now != page->shown)
+      live_write_page(ctx, ui, i);
+  }
+}
+
+static void export_synctex(fz_context *ctx, ui_state *ui)
+{
+  fz_buffer *buf = NULL;
+  send(synctex, ui->eng, &buf);
+  size_t len = strlen(pdf_output);
+  if (!buf || len < 4 || len > 4000 || strcmp(pdf_output + len - 4, ".pdf"))
+    return;
+  char path[4200], part[4200];
+  snprintf(path, sizeof path, "%.*s.synctex", (int)(len - 4), pdf_output);
+  snprintf(part, sizeof part, "%s.part", path);
+  FILE *f = fopen(part, "wb");
+  if (!f)
+    return;
+  bool written = fwrite(buf->data, 1, buf->len, f) == buf->len;
+  if (fclose(f) != 0 || !written || rename(part, path) != 0)
+  {
+    fprintf(stderr, "[pdf] couldn't write %s\n", path);
+    remove(part);
+  }
+}
+
+enum live_written { LIVE_WRITTEN, LIVE_INTERRUPTED, LIVE_FAILED };
+
+/* The whole document as typeset so far, to TEXPRESSO_PDF_OUTPUT. `interruptible`, it gives
+   way to a command waiting on stdin: the next keystroke's page comes first. */
+static enum live_written live_write_whole(fz_context *ctx, ui_state *ui, enum EDITOR_RUN run,
+                                          bool interruptible)
+{
+  int pages = send(page_count, ui->eng);
+  char part[4200];
+  snprintf(part, sizeof part, "%s.part", pdf_output);
+  fz_document_writer *writer = NULL;
+  bool interrupted = false;
+  fz_var(writer);
+  fz_var(interrupted);
+  fz_try(ctx)
+  {
+    writer = fz_new_pdf_writer(ctx, part, "");
+    for (int i = 0; i < pages && !interrupted; i++)
+    {
+      fz_device *dev = fz_begin_page(ctx, writer, txp_tex_page_box(ui->eng, i));
+      txp_tex_run_page(ui->eng, ctx, i, dev);
+      fz_end_page(ctx, writer);
+      interrupted = interruptible && (i & 3) == 3 && poll_stdin();
+    }
+    if (!interrupted)
+      fz_close_document_writer(ctx, writer);
+  }
+  fz_always(ctx)
+    fz_drop_document_writer(ctx, writer);
+  fz_catch(ctx)
+  {
+    fprintf(stderr, "[pdf] couldn't write %s: %s\n", part, fz_caught_message(ctx));
+    remove(part);
+    return LIVE_FAILED;
+  }
+  if (interrupted)
+  {
+    remove(part);
+    return LIVE_INTERRUPTED;
+  }
+  // Its SyncTeX beside it, as live.synctex for live.pdf, for the editor's jumps between
+  // source and pages; written first, so a PDF never comes without its own.
+  export_synctex(ctx, ui);
+  if (rename(part, pdf_output) != 0)
+  {
+    perror("[pdf] rename");
+    return LIVE_FAILED;
+  }
+
+  int *changed = fz_malloc_array(ctx, 2 * (pages + 1), int);
+  int ranges = 0;
+  for (int i = 0; i < live.cap; i++)
+  {
+    live_page *page = &live.pages[i];
+    if (i < pages && page->now != page->whole)
+    {
+      if (ranges && changed[2 * ranges - 1] == i - 1)
+        changed[2 * ranges - 1] = i;
+      else
+      {
+        changed[2 * ranges] = changed[2 * ranges + 1] = i;
+        ranges++;
+      }
+    }
+    page->whole = page->shown = i < pages ? page->now : 0;
+    live_retire(page, i, 0);
+  }
+  live.whole_pages = pages;
+  live.dirty = false;
+  live.whole_complete = run == RUN_COMPLETE;
+  if (run == RUN_COMPLETE)
+    live.had_complete = true;
+  editor_pdf(pdf_output, pages, run, changed, ranges, live_wish.mark);
+  fz_free(ctx, changed);
+  return LIVE_WRITTEN;
+}
+
+/* Steps `eng` until its page count leaves `count` (when not negative), a command waits, a
+   few ms have passed, or its worker has nothing more to say yet. Whether it has more. */
+static bool live_step(fz_context *ctx, txp_engine *eng, int count)
+{
+  double until = live_ms() + 4;
+  int steps = 0;
+  while (send(step, eng, ctx, false))
+  {
+    if (count >= 0 && send(page_count, eng) != count)
+      return true;
+    if ((++steps & 15) == 0 && (poll_stdin() || live_ms() > until))
+      return true;
+  }
+  return false;
+}
+
+/* Where the editor's caret settled, a snapshot is wanted just before it, so that the first
+   key typed there is as quick as the ones after it. A run that hasn't read that far takes
+   it on its way. One that is over is told of a change there that changes nothing, and takes
+   it as it does for a real change: the pages typeset again are the same pages, and nothing
+   is sent. A run in between is left to end first. */
+static void live_caret(struct persistent_state *ps, ui_state *ui)
+{
+  int offset = live_wish.caret_offset, at, go_up = 0;
+  if (offset < 0)
+    return;
+  const char *path = live_wish.caret_path;
+  if (path[0] == '/')
+    path = relative_path(path, ps->doc_path, &go_up);
+  fileentry_t *e = go_up > 0 ? NULL : send(find_file, ui->eng, ps->ctx, path), *warm;
+  bool running = send(get_status, ui->eng) == DOC_RUNNING;
+  if (!e || (txp_tex_warm(ui->eng, &warm, &at) && warm == e && offset >= at && offset - at < 256) ||
+      txp_tex_plant(ui->eng, e, offset))
+    live_wish.caret_offset = -1;
+  else if (!running)
+  {
+    live_wish.caret_offset = -1;
+    send(notify_file_changes, ui->eng, ps->ctx, e, offset);
+  }
+}
+
+static void live_pass_drop(fz_context *ctx)
+{
+  if (!live.pass)
+    return;
+  editor_mute(true);
+  send(destroy, live.pass, ctx);
+  editor_mute(false);
+  live.pass = NULL;
+}
+
+static void live_pass_start(struct persistent_state *ps, ui_state *ui,
+                            const char *engine_path, bool texlive)
+{
+  dvi_reshooks hooks = texlive ? dvi_texlive_hooks(ps->ctx, ps->doc_path)
+                               : dvi_tectonic_hooks(ps->ctx, ps->doc_path);
+  live.pass = txp_create_tex_engine(ps->ctx, engine_path, texlive, ps->stream_mode,
+                                    ps->inclusion_path, ps->doc_name, hooks);
+  live.passes++;
+  txp_tex_live(live.pass);
+  txp_tex_adopt(live.pass, ps->ctx, ui->eng);
+  // Its own snapshot where the first engine's is, for the edit after it takes over.
+  fileentry_t *warm;
+  int at;
+  if (txp_tex_warm(ui->eng, &warm, &at))
+    txp_tex_plant(live.pass, send(find_file, live.pass, ps->ctx, warm->path), at);
+  fprintf(stderr, "[live] finishing pass %d\n", live.passes);
+  editor_mute(true);
+  send(step, live.pass, ps->ctx, true);
+  editor_mute(false);
+}
+
+/* A slice of the finishing pass, which takes the first engine's place when it has reached
+   the end. Whether it has more steps waiting; `*promoted` when it is now the engine. */
+static bool live_pass_step(struct persistent_state *ps, ui_state *ui, bool *promoted)
+{
+  fz_context *ctx = ps->ctx;
+  editor_mute(true);
+  bool more = live_step(ctx, live.pass, -1);
+  bool over = send(get_status, live.pass) != DOC_RUNNING;
+  editor_mute(false);
+  if (!over)
+    return more;
+  if (txp_tex_outcome(live.pass) != RUN_COMPLETE)
+  {
+    // Not a document to show in place of one that reached its end: no more passes for now.
+    fprintf(stderr, "[live] finishing pass stopped on an error, dropped\n");
+    live.passes = LIVE_PASSES;
+    live_pass_drop(ctx);
+    return false;
+  }
+  txp_engine *old = ui->eng;
+  txp_tex_take_resources(live.pass, old);
+  ui->eng = live.pass;
+  live.pass = NULL;
+  editor_mute(true);
+  send(destroy, old, ctx);
+  editor_mute(false);
+  txp_tex_resend_output(ui->eng);
+  live.checked = 0;
+  *promoted = true;
+  return true;
+}
+
+/* What was said before a crash is what explains it. */
+static void live_crashed(int sig)
+{
+  (void)sig;
+  fflush(stderr);
+}
+
+static int live_env(const char *name, int value)
+{
+  const char *text = getenv(name);
+  return text && *text ? atoi(text) : value;
+}
+
+static void live_loop(struct persistent_state *ps, ui_state *ui, prot_parser *parser,
+                      vstack *stack, const char *engine_path, bool texlive)
+{
+  fz_context *ctx = ps->ctx;
+  snprintf(live.dir, sizeof live.dir, "%s", pdf_output);
+  char *slash = strrchr(live.dir, '/');
+  if (slash)
+    *slash = 0;
+  else
+    strcpy(live.dir, ".");
+  live.whole_pages = -1;
+  live.changed_at = -1e9;
+  // For measuring.
+  live_tail_ms = live_env("TEXPRESSO_LIVE_TAIL_MS", live_tail_ms);
+  live_whole_ms = live_env("TEXPRESSO_LIVE_WHOLE_MS", live_whole_ms);
+  live_rerun_ms = live_env("TEXPRESSO_LIVE_RERUN_MS", live_rerun_ms);
+  // The diagnostics of a keystroke in one write, not forty, for whoever reads them.
+  static char errors[1 << 15];
+  setvbuf(stderr, errors, _IOFBF, sizeof errors);
+  struct sigaction crashed = {.sa_handler = live_crashed, .sa_flags = SA_RESETHAND};
+  sigaction(SIGABRT, &crashed, NULL);
+  sigaction(SIGSEGV, &crashed, NULL);
+  sigaction(SIGBUS, &crashed, NULL);
+  txp_tex_live(ui->eng);
+  editor_live(1);
+
+  bool running = true; // a run whose end hasn't been told
+  for (;;)
+  {
+    int first = live_wish.first, last = live_wish.last;
+    live_wish.touched = false;
+    send(begin_changes, ui->eng, ctx);
+    if (read_commands(ps, ui, parser, stack))
+      break;
+    bool scanned = live_events & (1u << SCAN_EVENT);
+    live_events = 0;
+    flush_changes(ps, ui);
+    if (scanned)
+      send(detect_changes, ui->eng, ctx);
+    live_caret(ps, ui);
+    if (send(end_changes, ui->eng, ctx))
+    {
+      if (!ps->paused)
+        send(step, ui->eng, ctx, true);
+      running = true;
+      if (scanned)
+      {
+        live_wish.touched = true;
+        live.salt += 0x9e3779b97f4a7c15ull;
+      }
+    }
+    if (live_wish.touched)
+    {
+      // The files opened with the session aren't typing to wait out.
+      if (live.started)
+        live.changed_at = live_ms();
+      live.passes = 0;
+      live_pass_drop(ctx);
+    }
+
+    bool stepping = send(get_status, ui->eng) == DOC_RUNNING && !ps->paused;
+    int count = send(page_count, ui->eng);
+    // Pages in view first; the rest once typing has paused.
+    bool wanted = stepping && (count <= live_wish.last ||
+                               live_ms() - live.changed_at >= live_tail_ms);
+    bool more = wanted && live_step(ctx, ui->eng, count);
+    live_scan(ctx, ui, first != live_wish.first || last != live_wish.last);
+    stepping = send(get_status, ui->eng) == DOC_RUNNING && !ps->paused;
+    count = send(page_count, ui->eng);
+
+    if (running && !stepping && !ps->paused)
+    {
+      running = false;
+      live.started = true;
+      live.run = txp_tex_outcome(ui->eng);
+      live.aux = live.run == RUN_COMPLETE && txp_tex_aux_changed(ui->eng);
+      if (!live.aux)
+        live_wish.rerun = false;
+      editor_done(count, live.run);
+    }
+    if (live_wish.mark != live.synced && (!stepping || count > live_wish.last))
+    {
+      live.synced = live_wish.mark;
+      editor_synced(live.synced);
+    }
+
+    double now = live_ms(), wake = -1;
+    if (stepping)
+    {
+      // Something to show before a long document is done.
+      if (live.whole_pages < 0 && count > live_wish.last &&
+          live_write_whole(ctx, ui, RUN_PARTIAL, false) == LIVE_FAILED)
+        live.whole_pages = 0;
+      if (!wanted)
+        wake = live.changed_at + live_tail_ms;
+    }
+    else if (!running)
+    {
+      // The early document, or one of a run that stopped, is told as complete once it is,
+      // even with the same pages: the editor goes by what the last one said.
+      bool completed = live.run == RUN_COMPLETE && !live.whole_complete;
+      // A run that stopped on an error doesn't replace a document that reached its end.
+      bool differs = (live.dirty || count != live.whole_pages || completed) &&
+                     !(live.run == RUN_STOPPED && live.had_complete);
+      // Other pages wait for typing to pause; another number of them is told at once.
+      double due = live.run == RUN_COMPLETE && (count != live.whole_pages || completed)
+                       ? now : live.changed_at + live_whole_ms;
+      if (differs && now >= due)
+      {
+        enum live_written written =
+            live_write_whole(ctx, ui, live.run, live.whole_pages >= 0);
+        if (written == LIVE_INTERRUPTED)
+          more = true;
+        else if (written == LIVE_FAILED)
+          live.dirty = false, live.whole_pages = count;
+      }
+      else if (differs)
+        wake = due;
+
+      if (live_wish.rerun)
+        live.passes = fz_mini(live.passes, LIVE_PASSES - 1);
+      double pass_due = live_wish.rerun ? now : live.changed_at + live_rerun_ms;
+      if (live.pass)
+      {
+        bool promoted = false;
+        more = live_pass_step(ps, ui, &promoted) || more;
+        running = running || promoted;
+      }
+      else if (live.aux && live.passes < LIVE_PASSES && now >= pass_due)
+      {
+        live_wish.rerun = false;
+        live_pass_start(ps, ui, engine_path, texlive);
+        more = true;
+      }
+      else if (live.aux && live.passes < LIVE_PASSES && (wake < 0 || pass_due < wake))
+        wake = pass_due;
+    }
+    // A caret that waited for the run to end.
+    if (more || (!stepping && live_wish.caret_offset >= 0))
+      continue;
+
+    // Nothing to do until a command comes, a worker has more, or one of the pauses is over.
+    fflush(stderr);
+    struct pollfd fds[2] = {{STDIN_FILENO, POLLRDNORM, 0}, {-1, POLLRDNORM, 0}};
+    if (stepping && wanted)
+      fds[1].fd = txp_tex_worker_fd(ui->eng);
+    else if (!stepping && live.pass)
+      fds[1].fd = txp_tex_worker_fd(live.pass);
+    int timeout = wake < 0 ? -1 : fz_maxi((int)(wake - live_ms() + 0.999), 0);
+    if (poll(fds, 2, timeout) == -1 && errno != EINTR)
+      break;
+    if ((fds[0].revents & (POLLHUP | POLLERR | POLLNVAL)) && !poll_stdin())
+      break;
+  }
+  live_pass_drop(ctx);
+}
