+/* The whole document written to `path` (TEXPRESSO_PDF_OUTPUT), for the editor to show. */
+void editor_pdf(const char *path, int pages)
+{
+  switch (protocol)
+  {
+    case EDITOR_SEXP: fprintf(stdout, "(pdf \""); output_sexp_string(stdout, path, strlen(path)); break;
+    case EDITOR_JSON: fprintf(stdout, "[\"pdf\", \""); output_json_string(stdout, path, strlen(path)); break;
+  }
+  fprintf(stdout, protocol == EDITOR_SEXP ? "\" %d)\n" : "\", %d]\n", pages);
+  fflush(stdout);
+}
