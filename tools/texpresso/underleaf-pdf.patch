+// For the editor's own PDF view
+
+static struct tex_engine *live_engine(fz_context *ctx, const char *engine_path,
+                                      const char *inclusion_path, const char *name,
+                                      const char *root)
+{
+  struct tex_engine *self = (struct tex_engine *)txp_create_tex_engine(
+      ctx, engine_path, true, false, inclusion_path, name, dvi_texlive_hooks(ctx, root));
+  self->live = true;
+  self->root = fz_strdup(ctx, root);
+  return self;
+}
+
+txp_engine *txp_tex_live_engine(fz_context *ctx, const char *exe_path, const char *root,
+                                const char *name, const char *inputs)
+{
+  // Its TeX is beside it, and runs in the document's folder.
+  char engine_path[PATH_MAX];
+  snprintf(engine_path, sizeof engine_path, "%.*s/texpresso-xetex",
+           (int)(strrchr(exe_path, '/') - exe_path), exe_path);
+  if (chdir(root) != 0)
+    perror("chdir to the document's folder");
+  // The caller waits, on the worker and its own input together (txp_tex_worker_fd).
+  step_timeout = 0;
+  return (txp_engine *)live_engine(ctx, engine_path, inputs, name, root);
+}
+
+int txp_tex_worker_fd(txp_engine *_self)
+{
+  SELF;
+  if (self->pass)
+    return txp_tex_worker_fd((txp_engine *)self->pass);
+  if (self->process_count == 0 || self->deferred.active)
+    return -1;
+  return get_process(self)->fd;
+}
+
+uint64_t txp_tex_page_hash(txp_engine *_self, int page)
+{
+  SELF;
+  const unsigned char *data;
+  size_t len;
+  incdvi_page_bytes(self->dvi, self->st.document.entry->saved.data, page, &data, &len);
+  uint64_t hash = 0xcbf29ce484222325ull;
+  for (size_t i = 0; i < len; i++)
+    hash = (hash ^ data[i]) * 0x100000001b3ull;
+  return hash ? hash : 1;
+}
+
+// How a run that is over ended: TeX says goodbye either way, after a fatal error too.
+int txp_tex_outcome(txp_engine *_self)
+{
+  SELF;
+  static const char *const fatal[] = {
+    "\n! Emergency stop", "(That makes 100 errors; please try again.)",
+    "\n! TeX capacity exceeded", "\n! This can't happen", "\n! I can't go on meeting you",
+  };
+  fz_buffer *out = output_data(self->st.stdout.entry);
+  if (!out)
+    out = output_data(filesystem_lookup(self->fs, "stdout"));
+  if (!out)
+    return RUN_STOPPED;
+  for (int i = 0; i < 5; i++)
+    if (memmem(out->data, out->len, fatal[i], strlen(fatal[i])))
+      return RUN_STOPPED;
+  if (!memmem(out->data, out->len, "Output written on ", 18) &&
+      !memmem(out->data, out->len, "No pages of output.", 19))
+    return RUN_STOPPED;
+  return RUN_COMPLETE;
+}
+
+// Whether a file TeX reads and writes (.aux, .toc, .out) was written other than as read:
+// another pass would show other references or contents.
+bool txp_tex_aux_changed(txp_engine *_self)
+{
+  SELF;
+  if (self->pass_failed)
+    return false;
+  fileentry_t *e;
+  for (int index = 0; (e = filesystem_scan(self->fs, &index));)
+  {
+    if (e->saved.level != FILE_WRITE || !e->saved.data || !e->wanted ||
+        is_system_output(e->path))
+      continue;
+    fz_buffer *read = e->edit_data ? e->edit_data : e->fs_data;
+    size_t len = read ? read->len : 0;
+    if (len != e->saved.data->len || (len && memcmp(e->saved.data->data, read->data, len) != 0))
+      return true;
+  }
+  return false;
+}
+
+// A finishing pass of `from`, which has finished: the editor's buffers as they are, and
+// what `from` wrote to the files it reads as their contents.
+static void adopt(fz_context *ctx, struct tex_engine *self, struct tex_engine *from)
+{
+  fileentry_t *e;
+  for (int index = 0; (e = filesystem_scan(from->fs, &index));)
+  {
+    fz_buffer *data = e->edit_data;
+    bool written = false;
+    if ((!data || e->edit_data_from_convergence) && e->saved.level == FILE_WRITE &&
+        e->saved.data && !is_system_output(e->path))
+    {
+      data = e->saved.data;
+      written = true;
+    }
+    if (!data && !e->promised)
+      continue;
+    fileentry_t *mine = filesystem_lookup_or_create(ctx, self->fs, e->path);
+    mine->promised = e->promised;
+    if (data)
+    {
+      mine->edit_data = fz_new_buffer_from_copied_data(ctx, data->data, data->len);
+      mine->edit_data_from_convergence = written || e->edit_data_from_convergence;
+    }
+  }
+}
+
+// Where the last change or caret was: an edit there resumes a snapshot taken just before.
+bool txp_tex_warm(txp_engine *_self, fileentry_t **entry, int *offset)
+{
+  SELF;
+  if (entry) *entry = self->warm.entry;
+  if (offset) *offset = self->warm.position;
+  return self->warm.entry != NULL;
+}
+
+// Snapshots to come just before `offset` of `entry`, and a little further back, when no
+// worker has read that far: the first edit there resumes one instead of starting TeX again.
+// Whether they are set.
+bool txp_tex_plant(txp_engine *_self, fileentry_t *entry, int offset)
+{
+  SELF;
+  static const int back[] = {64, 512, 2048};
+  fz_buffer *data = entry_data(entry);
+  if ((self->fence_pos != -1 && !self->planted) || !data)
+    return false;
+  int count = 0;
+  for (int i = 0; i < 3; i++)
+  {
+    int position = fz_maxi(offset - back[i], 0) & ~(64 - 1);
+    if (position <= entry->read_end || position >= data->len ||
+        (count && position >= self->fences[count - 1].position))
+      break;
+    self->fences[count].entry = entry;
+    self->fences[count].position = position;
+    count++;
+  }
+  if (!count)
+    return false;
+  self->fence_pos = count - 1;
+  self->planted = true;
+  self->warm.trace = 0;
+  self->warm.entry = entry;
+  self->warm.position = offset;
+  return true;
+}
+
+// TeX's output and log from their start, to an editor that has another engine's.
+static void resend_output(struct tex_engine *self)
+{
+  fileentry_t *e, *out = self->st.stdout.entry, *log = self->st.log.entry;
+  for (int index = 0; (e = filesystem_scan(self->fs, &index));)
+  {
+    const char *dot = strrchr(e->path, '.');
+    if (!log && e->saved.level == FILE_WRITE && dot && strcmp(dot, ".log") == 0)
+      log = e;
+    if (!out && strcmp(e->path, "stdout") == 0)
+      out = e;
+  }
+  editor_truncate(BUF_OUT, NULL);
+  editor_truncate(BUF_LOG, NULL);
+  editor_append(BUF_OUT, output_data(out), 0);
+  editor_append(BUF_LOG, output_data(log), 0);
+}
+
+// A finishing pass runs in a second TeX, while this one's snapshots still answer an edit,
+// which drops the pass: forked workers started over would leave none near the caret.
+void txp_tex_rerun(txp_engine *_self, fz_context *ctx)
+{
+  SELF;
+  struct tex_engine *pass =
+      live_engine(ctx, self->engine_path, self->inclusion_path, self->name, self->root);
+  adopt(ctx, pass, self);
+  // Its own snapshot where this one's is, for the edit after it takes over.
+  if (self->warm.entry)
+    txp_tex_plant((txp_engine *)pass,
+                  filesystem_lookup_or_create(ctx, pass->fs, self->warm.entry->path),
+                  self->warm.position);
+  self->pass = pass;
+  editor_mute(true);
+  engine_step((txp_engine *)pass, ctx, true);
+  editor_mute(false);
+}
+
+static bool pass_step(fz_context *ctx, struct tex_engine *self)
+{
+  struct tex_engine *pass = self->pass;
+  editor_mute(true);
+  bool stepped = engine_step((txp_engine *)pass, ctx, false);
+  editor_mute(false);
+  if (engine_get_status((txp_engine *)pass) == DOC_RUNNING)
+    return stepped;
+  // Stopped on an error, it shows no document in place of one that reached its end.
+  if (txp_tex_outcome((txp_engine *)pass) != RUN_COMPLETE)
+  {
+    fprintf(stderr, "[live] finishing pass stopped on an error, dropped\n");
+    drop_pass(ctx, self);
+    self->pass_failed = true;
+    return false;
+  }
+  // Over, it takes this engine's place, with its fonts.
+  incdvi_take_resources(pass->dvi, self->dvi);
+  resend_output(pass);
+  self->next = pass;
+  self->pass = NULL;
+  return false;
+}
+
+txp_engine *txp_tex_successor(txp_engine *_self, fz_context *ctx)
+{
+  SELF;
+  struct tex_engine *next = self->next;
+  if (!next)
+    return _self;
+  editor_mute(true);
+  engine_destroy(_self, ctx);
+  editor_mute(false);
+  return (txp_engine *)next;
+}
+
+fz_rect txp_tex_page_box(txp_engine *_self, int page)
+{
+  SELF;
+  float pw, ph;
+  incdvi_page_dim(self->dvi, self->st.document.entry->saved.data, page, &pw, &ph, NULL);
+  return fz_make_rect(0, 0, pw, ph);
+}
+
+// The page straight to a device: a display list in between is only for drawing it again.
+void txp_tex_run_page(txp_engine *_self, fz_context *ctx, int page, fz_device *dev)
+{
+  SELF;
+  incdvi_render_page(ctx, self->dvi, self->st.document.entry->saved.data, page, dev);
+}
