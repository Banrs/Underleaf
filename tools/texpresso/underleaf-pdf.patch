+void incdvi_page_bytes(incdvi_t *d, fz_buffer *buf, int page, const unsigned char **data, size_t *len)
+{
+  if (page < 0 || page >= incdvi_page_count(d)) abort();
+  int bop = d->pages[page * 2] + 45, eop = d->pages[page * 2 + 1];
+  if (bop > eop) bop = eop;
+  *data = buf->data + bop;
+  *len = eop - bop;
+}
+
+void incdvi_take_resources(incdvi_t *d, incdvi_t *from)
+{
+  dvi_context *dc = d->dc;
+  dvi_context_state(from->dc)->version = dvi_context_state(dc)->version;
+  from->dc->scale = dc->scale;
+  d->dc = from->dc;
+  from->dc = dc;
+  // The font definitions are read again, into the font table taken.
+  d->fontdef_offset = 0;
+}
