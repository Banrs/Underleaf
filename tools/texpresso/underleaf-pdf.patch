 /* Document processing */
 
+/* TEXPRESSO_PDF_OUTPUT: the document runs to its end, then every page is written there. */
+static const char *pdf_output;
+static bool pdf_dirty;
+
+static void export_pdf(fz_context *ctx, ui_state *ui)
+{
+  int pages = send(page_count, ui->eng);
+  char part[4200];
+  snprintf(part, sizeof part, "%s.part", pdf_output);
+  fz_document_writer *writer = NULL;
+  fz_display_list *dl = NULL;
+  fz_var(writer);
+  fz_var(dl);
+  fz_try(ctx)
+  {
+    writer = fz_new_pdf_writer(ctx, part, "");
+    for (int i = 0; i < pages; i++)
+    {
+      dl = send(render_page, ui->eng, ctx, i);
+      fz_device *dev = fz_begin_page(ctx, writer, fz_bound_display_list(ctx, dl));
+      fz_run_display_list(ctx, dl, dev, fz_identity, fz_infinite_rect, NULL);
+      fz_end_page(ctx, writer);
+      fz_drop_display_list(ctx, dl);
+      dl = NULL;
+    }
+    fz_close_document_writer(ctx, writer);
+  }
+  fz_always(ctx)
+  {
+    fz_drop_display_list(ctx, dl);
+    fz_drop_document_writer(ctx, writer);
+  }
+  fz_catch(ctx)
+  {
+    fprintf(stderr, "[pdf] couldn't write %s: %s\n", part, fz_caught_message(ctx));
+    remove(part);
+    return;
+  }
+  if (rename(part, pdf_output) == 0)
+    editor_pdf(pdf_output, pages);
+  else
+    perror("[pdf] rename");
+}
