+/* Writing pages for an editor's own PDF view (live.c), stderr holds a keystroke's
+   diagnostics until the loop waits, so the editor reading them wakes once, not forty
+   times. What was said before a crash is what explains it: the buffer is written as it
+   is, as fflush isn't safe in a signal handler (Darwin's FILE). */
+static char diagnostics[1 << 15];
+
+static void crashed(int sig)
+{
+  (void)sig;
+  write(STDERR_FILENO, diagnostics, stderr->_p - (unsigned char *)diagnostics);
+}
+
+static int live(int argc, const char **argv, const char *pdf_output)
+{
+  setvbuf(stderr, diagnostics, _IOFBF, sizeof diagnostics);
+  struct sigaction crash = {.sa_handler = crashed, .sa_flags = SA_RESETHAND};
+  sigaction(SIGABRT, &crash, NULL);
+  sigaction(SIGSEGV, &crash, NULL);
+  sigaction(SIGBUS, &crash, NULL);
+  char exe_path[PATH_MAX];
+  if (!get_executable_path(exe_path) && !realpath(argv[0], exe_path))
+  {
+    perror("finding executable path");
+    return 1;
+  }
+  return txp_live_main(argc, argv, exe_path, pdf_output, STDIN_FILENO);
+}
+
 int main(int argc, const char **argv)
 {
+  const char *pdf_output = getenv("TEXPRESSO_PDF_OUTPUT");
+  if (pdf_output && *pdf_output)
+    return live(argc, argv, pdf_output);
+
   // Unbuffered stderr so debug/[fatal] lines hit disk before a crash.
   setvbuf(stderr, NULL, _IONBF, 0);
 
