{
  "blocks": {
    "figure": "\\begin{figure}[h]\n\t\\centering\n\t\\includegraphics[width=0.8\\linewidth]{#{}}\n\t\\caption{#{}}\n\t\\label{fig:#{}}\n\\end{figure}\n",
