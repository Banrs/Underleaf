[
  {
    "name": "an empty document is one line",
    "text": "",
    "expected": {
      "outline": [],
      "words": 0,
      "lines": 1
    }
  },
  {
    "name": "a trailing newline starts a line",
    "text": "Hello world\n",
    "expected": {
      "outline": [],
      "words": 2,
      "lines": 2
    }
  },
  {
    "name": "CR LF, CR and LF each end a line",
    "text": "one\r\ntwo\rthree\nfour\r\r\nfive",
    "expected": {
      "outline": [],
      "words": 5,
      "lines": 6
    }
  },
  {
    "name": "every sectioning level",
    "text": "\\part{P}\n\\chapter{C}\n\\section{S}\n\\subsection{Sub}\n\\subsubsection{SubSub}\n\\paragraph{Para}\n\\subparagraph{Not in the outline}",
    "expected": {
      "outline": [
        {
          "depth": 0,
          "title": "P",
          "line": 1
        },
        {
          "depth": 1,
          "title": "C",
          "line": 2
        },
        {
          "depth": 2,
          "title": "S",
          "line": 3
        },
        {
          "depth": 3,
          "title": "Sub",
          "line": 4
        },
        {
          "depth": 4,
          "title": "SubSub",
          "line": 5
        },
        {
          "depth": 5,
          "title": "Para",
          "line": 6
        }
      ],
      "words": 10,
      "lines": 7
    }
  },
  {
    "name": "stars, short titles and spaces",
    "text": "\\section*{Starred}\n\\section[Short]{Long title}\n\\subsection * [x] {Spaced}\n\\section {After a no-break space}",
    "expected": {
      "outline": [
        {
          "depth": 2,
          "title": "Starred",
          "line": 1
        },
        {
          "depth": 2,
          "title": "Long title",
          "line": 2
        },
        {
          "depth": 2,
          "title": "After a no-break space",
          "line": 4
        }
      ],
      "words": 9,
      "lines": 4
    }
  },
  {
    "name": "an empty title is untitled",
    "text": "\\section{}\n\\chapter*{}",
    "expected": {
      "outline": [
        {
          "depth": 2,
          "title": "(untitled)",
          "line": 1
        },
        {
          "depth": 1,
          "title": "(untitled)",
          "line": 2
        }
      ],
      "words": 0,
      "lines": 2
    }
  },
  {
    "name": "the first heading on a line wins",
    "text": "Text \\section{A} and \\subsection{B}",
    "expected": {
      "outline": [
        {
          "depth": 2,
          "title": "A",
          "line": 1
        }
      ],
      "words": 4,
      "lines": 1
    }
  },
  {
    "name": "a commented-out heading is skipped",
    "text": "% \\section{Hidden}\n  \t% \\section{Indented}\n\\section{Shown} % \\section{After}",
    "expected": {
      "outline": [
        {
          "depth": 2,
          "title": "Shown",
          "line": 3
        }
      ],
      "words": 1,
      "lines": 3
    }
  },
  {
    "name": "a heading inside a comment later on the line still counts",
    "text": "Words % \\section{Trailing}",
    "expected": {
      "outline": [
        {
          "depth": 2,
          "title": "Trailing",
          "line": 1
        }
      ],
      "words": 1,
      "lines": 1
    }
  },
  {
    "name": "a title keeps its nested groups, as plain text",
    "text": "\\section{The \\emph{Real} Problem}\n\\subsection{Sets \\{x\\} and {\\em y}}\n\\section{Unclosed {group}",
    "expected": {
      "outline": [
        {
          "depth": 2,
          "title": "The Real Problem",
          "line": 1
        },
        {
          "depth": 3,
          "title": "Sets {x} and y",
          "line": 2
        }
      ],
      "words": 9,
      "lines": 3
    }
  },
  {
    "name": "a title shows as plain text: PDF strings, styles, labels and notes",
    "text": "\\section{\\texorpdfstring{$\\mathbf{E}$-fields}{E-fields} and \\textbf{More}}\n\\subsection{A {\\bfseries Bold} \\textit{and} {\\itshape Slanted} Heading\\label{sec:a}}\n\\section{Notes\\footnote{See \\cite{x}.}}\n\\section{\\label{sec:only}}\n\\section{  Spaced\t  \\LaTeX\\ and \\emphasis  }\n\\section{\\texorpdfstring{{\\cjkfont 中文}}{中文} — Chinese}\n\\section{R\\&D at 50\\% \\{set\\}}",
    "expected": {
      "outline": [
        {
          "depth": 2,
          "title": "E-fields and More",
          "line": 1
        },
        {
          "depth": 3,
          "title": "A Bold and Slanted Heading",
          "line": 2
        },
        {
          "depth": 2,
          "title": "Notes",
          "line": 3
        },
        {
          "depth": 2,
          "title": "(untitled)",
          "line": 4
        },
        {
          "depth": 2,
          "title": "Spaced \\LaTeX\\ and \\emphasis",
          "line": 5
        },
        {
          "depth": 2,
          "title": "中文 — Chinese",
          "line": 6
        },
        {
          "depth": 2,
          "title": "R&D at 50% {set}",
          "line": 7
        }
      ],
      "words": 24,
      "lines": 7
    }
  },
  {
    "name": "commands and their options are not words",
    "text": "Hello \\textbf{bold} world \\cite[p.~3]{key} text \\\\ done",
    "expected": {
      "outline": [],
      "words": 6,
      "lines": 1
    }
  },
  {
    "name": "comments are not words",
    "text": "one two % three four\n50\\% off % really\n\\\\% comment after a line break",
    "expected": {
      "outline": [],
      "words": 8,
      "lines": 3
    }
  },
  {
    "name": "specials separate words",
    "text": "x^2 + y_1 = $a$ and~b & c{d}e",
    "expected": {
      "outline": [],
      "words": 8,
      "lines": 1
    }
  },
  {
    "name": "numbers alone are not words",
    "text": "123 456 7.5 foo123",
    "expected": {
      "outline": [],
      "words": 1,
      "lines": 1
    }
  },
  {
    "name": "letters of any script are letters",
    "text": "Café naïve ſ Ελληνικά κείμενο Русский 中文 123",
    "expected": {
      "outline": [],
      "words": 7,
      "lines": 1
    }
  },
  {
    "name": "JavaScript whitespace",
    "text": "a﻿b c d ef",
    "expected": {
      "outline": [],
      "words": 5,
      "lines": 1
    }
  },
  {
    "name": "a line separator stops the comment",
    "text": "a % b c",
    "expected": {
      "outline": [],
      "words": 3,
      "lines": 1
    }
  },
  {
    "name": "an unclosed option is kept",
    "text": "\\foo[unclosed text",
    "expected": {
      "outline": [],
      "words": 2,
      "lines": 1
    }
  },
  {
    "name": "an emoji is part of a word",
    "text": "😀word 😀",
    "expected": {
      "outline": [],
      "words": 1,
      "lines": 1
    }
  },
  {
    "name": "a starred command with an option",
    "text": "\\includegraphics*[width=\\linewidth]{figure} caption",
    "expected": {
      "outline": [],
      "words": 2,
      "lines": 1
    }
  },
  {
    "name": "title arguments balance nested and escaped braces",
    "text": "\\section{\\texorpdfstring{\\textbf{\\emph{TeX}}}{PDF}}\n\\section{A\\footnote{An \\emph{inner \\textbf{note}}}}\n\\section{A\\footnote{brace \\} still a note}}",
    "expected": {
      "outline": [
        {
          "depth": 2,
          "title": "PDF",
          "line": 1
        },
        {
          "depth": 2,
          "title": "A",
          "line": 2
        },
        {
          "depth": 2,
          "title": "A",
          "line": 3
        }
      ],
      "words": 11,
      "lines": 3
    }
  }
]
